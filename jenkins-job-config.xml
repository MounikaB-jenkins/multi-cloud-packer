<?xml version='1.1' encoding='UTF-8'?>
<flow-definition plugin="workflow-job@1306.v9a9cd34d1ed2">
  <actions/>
  <description>Multi-cloud Packer Pipeline - Builds cloud images for AWS, GCP, and Azure</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <com.coralogix.jenkins.integration.plugins.CoralogixPlugin plugin="coralogix-jenkins-integration@1.0.0">
      <enabled>false</enabled>
    </com.coralogix.jenkins.integration.plugins.CoralogixPlugin>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.StringParameterDefinition>
          <name>IMAGE_NAME</name>
          <description>Name for the Packer image</description>
          <defaultValue>multi-cloud-ubuntu</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>AWS_REGION</name>
          <description>AWS region for AMI</description>
          <defaultValue>us-east-1</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>GCP_PROJECT</name>
          <description>GCP project ID</description>
          <defaultValue>packer-demo-456789</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>GCP_ZONE</name>
          <description>GCP zone</description>
          <defaultValue>us-central1-a</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>AZURE_LOCATION</name>
          <description>Azure region</description>
          <defaultValue>East US</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>AZURE_RESOURCE_GROUP</name>
          <description>Azure resource group</description>
          <defaultValue>packer-resources</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.BooleanParameterDefinition>
          <name>BUILD_AWS</name>
          <description>Build AWS AMI</description>
          <defaultValue>true</defaultValue>
        </hudson.model.BooleanParameterDefinition>
        <hudson.model.BooleanParameterDefinition>
          <name>BUILD_GCP</name>
          <description>Build GCP Image</description>
          <defaultValue>true</defaultValue>
        </hudson.model.BooleanParameterDefinition>
        <hudson.model.BooleanParameterDefinition>
          <name>BUILD_AZURE</name>
          <description>Build Azure Image</description>
          <defaultValue>true</defaultValue>
        </hudson.model.BooleanParameterDefinition>
        <hudson.model.BooleanParameterDefinition>
          <name>DEPLOY_AWS</name>
          <description>Deploy AWS EC2 Instance</description>
          <defaultValue>true</defaultValue>
        </hudson.model.BooleanParameterDefinition>
        <hudson.model.BooleanParameterDefinition>
          <name>DEPLOY_GCP</name>
          <description>Deploy GCP VM</description>
          <defaultValue>true</defaultValue>
        </hudson.model.BooleanParameterDefinition>
        <hudson.model.BooleanParameterDefinition>
          <name>DEPLOY_AZURE</name>
          <description>Deploy Azure VM</description>
          <defaultValue>true</defaultValue>
        </hudson.model.BooleanParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
    <com.cloudbees.plugins.credentials.impl.CredentialsProvider plugin="credentials@1319.v7eb_51b_03e4b_d">
      <store/>
      <domainCredentialsMap class="hudson.util.CopyOnWriteMap+Tree"/>
    </com.cloudbees.plugins.credentials.impl.CredentialsProvider>
    <org.jenkinsci.plugins.workflow.job.properties.PipelineTriggersJobProperty>
      <triggers>
        <com.cloudbees.jenkins.GitHubPushTrigger plugin="github@1.36.1">
          <spec></spec>
        </com.cloudbees.jenkins.GitHubPushTrigger>
      </triggers>
    </org.jenkinsci.plugins.workflow.job.properties.PipelineTriggersJobProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps@2.97">
    <scm class="hudson.plugins.git.GitSCM" plugin="git@5.2.2">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <url>https://github.com/MounikaB-jenkins/multi-cloud-packer.git</url>
          <credentialsId>github-token</credentialsId>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/main</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="java.util.ArrayList"/>
      <extensions>
        <hudson.plugins.git.extensions.impl.CleanCheckout/>
        <hudson.plugins.git.extensions.impl.CleanBeforeCheckout/>
      </extensions>
    </scm>
    <scriptPath>Jenkinsfile</scriptPath>
    <lightweight>false</lightweight>
  </definition>
  <triggers/>
  <disabled>false</disabled>
</flow-definition>
