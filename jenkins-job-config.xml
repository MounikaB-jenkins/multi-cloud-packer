<?xml version='1.1' encoding='UTF-8'?>
<flow-definition plugin="workflow-job@1306.v9a9cd34d1ed2">
  <actions/>
  <description>Multi-cloud Packer Pipeline - Builds cloud images for AWS, GCP, and Azure</description>
  <keepDependencies>false</keepDependencies>
  <properties>
    <com.coralogix.jenkins.integration.plugins.CoralogixPlugin plugin="coralogix-jenkins-integration@1.0.0">
      <enabled>false</enabled>
    </com.coralogix.jenkins.integration.plugins.CoralogixPlugin>
    <hudson.model.ParametersDefinitionProperty>
      <parameterDefinitions>
        <hudson.model.ChoiceParameterDefinition>
          <name>ACTION</name>
          <description>The action to perform: SETUP_INFRA to create networking, BUILD a new image, DEPLOY an instance from an image, or STOP a running instance.</description>
          <choices class="java.util.Arrays$ArrayList">
            <a class="string-array">
              <string>SETUP_INFRA</string>
              <string>BUILD</string>
              <string>DEPLOY</string>
              <string>STOP</string>
            </a>
          </choices>
        </hudson.model.ChoiceParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>BRANCH_NAME</name>
          <description>The Git branch to checkout and execute.</description>
          <defaultValue>development</defaultValue>
          <trim>true</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.ChoiceParameterDefinition>
          <name>CLOUD</name>
          <description>The target cloud provider.</description>
          <choices class="java.util.Arrays$ArrayList">
            <a class="string-array">
              <string>AWS</string>
              <string>GCP</string>
              <string>AZURE</string>
            </a>
          </choices>
        </hudson.model.ChoiceParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>IMAGE_NAME</name>
          <description>Name for the Packer image (used for BUILD action).</description>
          <defaultValue>multi-cloud-image</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.ChoiceParameterDefinition>
          <name>IMAGE_TYPE</name>
          <description>Operating system type (used for BUILD action).</description>
          <choices class="java.util.Arrays$ArrayList">
            <a class="string-array">
              <string>Linux</string>
              <string>Windows</string>
            </a>
          </choices>
        </hudson.model.ChoiceParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>IMAGE_ID</name>
          <description>The Image ID to launch (AMI ID, GCP Image Name, Azure Image ID). Required for DEPLOY action.</description>
          <defaultValue></defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>INSTANCE_ID</name>
          <description>The ID of the instance to stop. Required for STOP action.</description>
          <defaultValue></defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>SECRET_NAME</name>
          <description>The name of the secret holding the SSH key (e.g., prod-key-1-secret). Required for DEPLOY action.</description>
          <defaultValue></defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>EMAIL</name>
          <description>Email for instance status notification</description>
          <defaultValue>mounika.b5693@outlook.com</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>AWS_REGION</name>
          <description>AWS region for all operations.</description>
          <defaultValue>us-east-1</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>GCP_PROJECT</name>
          <description>GCP project ID.</description>
          <defaultValue>packer-demo-456789</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>GCP_ZONE</name>
          <description>GCP zone for all operations.</description>
          <defaultValue>us-central1-a</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>AZURE_RESOURCE_GROUP</name>
          <description>Azure resource group.</description>
          <defaultValue>packer-resources</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>AZURE_LOCATION</name>
          <description>Azure location for all operations.</description>
          <defaultValue>East US</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>AWS_VPC_ID</name>
          <description>AWS VPC ID for Packer build and deployment (required if no default VPC exists).</description>
          <defaultValue></defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>AWS_SUBNET_ID</name>
          <description>AWS Subnet ID for Packer build and deployment (required if no default VPC exists).</description>
          <defaultValue></defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
        <hudson.model.StringParameterDefinition>
          <name>AZURE_VAULT_NAME</name>
          <description>Azure Key Vault name for storing/retrieving secrets.</description>
          <defaultValue>packer-vault</defaultValue>
          <trim>false</trim>
        </hudson.model.StringParameterDefinition>
      </parameterDefinitions>
    </hudson.model.ParametersDefinitionProperty>
    <com.cloudbees.plugins.credentials.impl.CredentialsProvider plugin="credentials@1319.v7eb_51b_03e4b_d">
      <store/>
      <domainCredentialsMap class="hudson.util.CopyOnWriteMap+Tree"/>
    </com.cloudbees.plugins.credentials.impl.CredentialsProvider>
    <org.jenkinsci.plugins.workflow.job.properties.PipelineTriggersJobProperty>
      <triggers>
        <com.cloudbees.jenkins.GitHubPushTrigger plugin="github@1.36.1">
          <spec></spec>
        </com.cloudbees.jenkins.GitHubPushTrigger>
      </triggers>
    </org.jenkinsci.plugins.workflow.job.properties.PipelineTriggersJobProperty>
  </properties>
  <definition class="org.jenkinsci.plugins.workflow.cps.CpsScmFlowDefinition" plugin="workflow-cps@2.97">
    <scm class="hudson.plugins.git.GitSCM" plugin="git@5.2.2">
      <configVersion>2</configVersion>
      <userRemoteConfigs>
        <hudson.plugins.git.UserRemoteConfig>
          <url>https://github.com/MounikaB-jenkins/multi-cloud-packer.git</url>
          <credentialsId>github-token</credentialsId>
        </hudson.plugins.git.UserRemoteConfig>
      </userRemoteConfigs>
      <branches>
        <hudson.plugins.git.BranchSpec>
          <name>*/${BRANCH_NAME}</name>
        </hudson.plugins.git.BranchSpec>
      </branches>
      <doGenerateSubmoduleConfigurations>false</doGenerateSubmoduleConfigurations>
      <submoduleCfg class="java.util.ArrayList"/>
      <extensions>
        <hudson.plugins.git.extensions.impl.CleanCheckout/>
        <hudson.plugins.git.extensions.impl.CleanBeforeCheckout/>
      </extensions>
    </scm>
    <scriptPath>Jenkinsfile.groovy</scriptPath>
    <lightweight>false</lightweight>
  </definition>
  <triggers/>
  <disabled>false</disabled>
</flow-definition>
