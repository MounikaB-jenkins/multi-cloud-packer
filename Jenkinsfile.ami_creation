def PACKER = 'C:\\DevopsProject\\packer.exe'

pipeline {
    agent any

    parameters {
        choice(name: 'CLOUD_PROVIDER', choices: ['ALL', 'AWS', 'GCP', 'AZURE'], description: 'Select cloud provider(s) to build images for')
        string(name: 'IMAGE_NAME', defaultValue: 'multi-cloud-ubuntu', description: 'Name for the Packer image')
        string(name: 'EMAIL', defaultValue: 'mounika.b5693@outlook.com', description: 'Email for notification')
    }

    environment {
        PACKER_TEMPLATE = 'aws-ubuntu.pkr.hcl'
    }

    stages {
        stage('Gather Cloud Parameters') {
            steps {
                script {
                    // Initialize default environment variables to avoid nulls
                    env.AWS_REGION = 'us-east-1'
                    env.GCP_PROJECT = 'packer-demo-456789'
                    env.GCP_ZONE = 'us-central1-a'
                    env.AZURE_LOCATION = 'eastus'
                    env.AZURE_VAULT_NAME = 'packer-vault'
                    env.AZURE_RESOURCE_GROUP = 'packer-resources'
                    env.AZURE_SUBSCRIPTION_ID = 'b943e408-73c1-4cea-b780-689120606f67'
                    env.AZURE_TENANT_ID = '8344e416-02b8-4b70-a912-1995cc408f19'

                    if (params.CLOUD_PROVIDER == 'AWS' || params.CLOUD_PROVIDER == 'ALL') {
                        def awsParams = input(
                            id: 'aws-input',
                            message: 'Provide AWS Configuration',
                            parameters: [
                                string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'AWS region')
                            ]
                        )
                        env.AWS_REGION = awsParams
                    }

                    if (params.CLOUD_PROVIDER == 'GCP' || params.CLOUD_PROVIDER == 'ALL') {
                        def gcpParams = input(
                            id: 'gcp-input',
                            message: 'Provide GCP Configuration',
                            parameters: [
                                string(name: 'GCP_PROJECT', defaultValue: 'packer-demo-456789', description: 'GCP project ID'),
                                string(name: 'GCP_ZONE', defaultValue: 'us-central1-a', description: 'GCP zone')
                            ]
                        )
                        env.GCP_PROJECT = gcpParams['GCP_PROJECT']
                        env.GCP_ZONE = gcpParams['GCP_ZONE']
                    }

                    if (params.CLOUD_PROVIDER == 'AZURE' || params.CLOUD_PROVIDER == 'ALL') {
                        def azureParams = input(
                            id: 'azure-input',
                            message: 'Provide Azure Configuration',
                            parameters: [
                                string(name: 'AZURE_LOCATION', defaultValue: 'eastus', description: 'Azure region for resource creation'),
                                string(name: 'AZURE_VAULT_NAME', defaultValue: 'packer-vault', description: 'Azure Key Vault name'),
                                string(name: 'AZURE_RESOURCE_GROUP', defaultValue: 'packer-resources', description: 'Azure resource group'),
                                string(name: 'AZURE_SUBSCRIPTION_ID', defaultValue: 'b943e408-73c1-4cea-b780-689120606f67', description: 'Azure subscription ID'),
                                string(name: 'AZURE_TENANT_ID', defaultValue: '8344e416-02b8-4b70-a912-1995cc408f19', description: 'Azure tenant ID')
                            ]
                        )
                        env.AZURE_LOCATION = azureParams['AZURE_LOCATION']
                        env.AZURE_VAULT_NAME = azureParams['AZURE_VAULT_NAME']
                        env.AZURE_RESOURCE_GROUP = azureParams['AZURE_RESOURCE_GROUP']
                        env.AZURE_SUBSCRIPTION_ID = azureParams['AZURE_SUBSCRIPTION_ID']
                        env.AZURE_TENANT_ID = azureParams['AZURE_TENANT_ID']
                    }
                }
            }
        }

        stage('Checkout') {
            steps {
                deleteDir()
                git branch: 'main',
                      credentialsId: 'github-token',
                      url: 'https://github.com/MounikaB-jenkins/multi-cloud-packer.git'
            }
        }

        stage('Init & Validate') {
            steps {
                bat """
                @echo off
                if exist "C:\\DevopsProject\\packer.exe" (
                    copy /Y "C:\\DevopsProject\\packer.exe" .\\packer.exe
                ) else (
                    echo ERROR: Packer executable not found at C:\\DevopsProject\\packer.exe
                    exit /b 1
                )
                packer.exe init .
                packer.exe validate %PACKER_TEMPLATE%
                """
            }
        }

        stage('Setup and Store Keys') {
            steps {
                script {
                    env.KEY_NAME = "prod-key-${BUILD_NUMBER}"
                    withCredentials([
                        usernamePassword(credentialsId: 'aws-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY'),
                        file(credentialsId: 'gcp-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS'),
                        usernamePassword(credentialsId: 'azure-creds', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET')
                    ]) {
                        bat """
                        @echo off
                        setlocal enabledelayedexpansion
                        
                        echo [INFO] Searching for Cloud SDKs...

                        :: Find gcloud executable
                        set "GCLOUD_EXE="
                        where gcloud >nul 2>&1
                        if !ERRORLEVEL! equ 0 (
                            set "GCLOUD_EXE=gcloud"
                        ) else (
                            for %%p in ("C:\\Users\\vresh\\AppData\\Local\\Google\\Cloud SDK\\google-cloud-sdk\\bin" "C:\\Program Files (x86)\\Google\\Cloud SDK\\google-cloud-sdk\\bin" "C:\\Program Files\\Google\\Cloud SDK\\google-cloud-sdk\\bin" "%LocalAppData%\\Google\\Cloud SDK\\google-cloud-sdk\\bin") do (
                                if exist "%%~p\\gcloud.cmd" if "!GCLOUD_EXE!"=="" set "GCLOUD_EXE=%%~p\\gcloud.cmd"
                            )
                        )

                        :: Find az executable
                        set "AZ_EXE="
                        where az >nul 2>&1
                        if !ERRORLEVEL! equ 0 (
                            set "AZ_EXE=az"
                        ) else (
                            for %%p in ("C:\\Program Files (x86)\\Microsoft SDKs\\Azure\\CLI2\\wbin" "C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\bin") do (
                                if exist "%%~p\\az.cmd" if "!AZ_EXE!"=="" set "AZ_EXE=%%~p\\az.cmd"
                            )
                        )

                        echo Generating SSH keypair...
                        ssh-keygen -t rsa -b 2048 -f private_key.pem -N ""
                        
                        :: AWS Storage
                        if "${params.CLOUD_PROVIDER}"=="ALL" set RUN_AWS=true
                        if "${params.CLOUD_PROVIDER}"=="AWS" set RUN_AWS=true
                        if "!RUN_AWS!"=="true" (
                            echo Storing key in AWS Secrets Manager...
                            set AWS_ACCESS_KEY_ID=%AWS_ACCESS_KEY_ID%
                            set AWS_SECRET_ACCESS_KEY=%AWS_SECRET_ACCESS_KEY%
                            call aws ec2 import-key-pair --key-name %KEY_NAME% --public-key-material fileb://private_key.pem.pub --region ${env.AWS_REGION}
                            call aws secretsmanager create-secret --name %KEY_NAME%-secret --secret-string file://private_key.pem --region ${env.AWS_REGION}
                        )
                        
                        :: GCP Storage
                        if "${params.CLOUD_PROVIDER}"=="ALL" set RUN_GCP=true
                        if "${params.CLOUD_PROVIDER}"=="GCP" set RUN_GCP=true
                        if "!RUN_GCP!"=="true" (
                            echo Storing key in GCP Secret Manager...
                            if "!GCLOUD_EXE!"=="" (
                                echo ERROR: gcloud CLI not found. Checked common paths.
                                exit /b 1
                            )
                            set GOOGLE_APPLICATION_CREDENTIALS=%GOOGLE_APPLICATION_CREDENTIALS%
                            call "!GCLOUD_EXE!" secrets create %KEY_NAME%-secret --replication-policy="automatic" --project=${env.GCP_PROJECT} 2>nul
                            call "!GCLOUD_EXE!" secrets versions add %KEY_NAME%-secret --data-file=private_key.pem --project=${env.GCP_PROJECT}
                        )
                        
                        :: Azure Storage
                        if "${params.CLOUD_PROVIDER}"=="ALL" set RUN_AZURE=true
                        if "${params.CLOUD_PROVIDER}"=="AZURE" set RUN_AZURE=true
                        if "!RUN_AZURE!"=="true" (
                            echo Storing key in Azure Key Vault...
                            if "!AZ_EXE!"=="" (
                                echo ERROR: Azure CLI 'az' not found. Checked common paths.
                                exit /b 1
                            )
                            set ARM_CLIENT_ID=%ARM_CLIENT_ID%
                            set ARM_CLIENT_SECRET=%ARM_CLIENT_SECRET%
                            call "!AZ_EXE!" login --service-principal -u %ARM_CLIENT_ID% -p %ARM_CLIENT_SECRET% --tenant ${env.AZURE_TENANT_ID}
                            call "!AZ_EXE!" account set --subscription ${env.AZURE_SUBSCRIPTION_ID}
                            
                            :: Ensure Resource Group exists
                            call "!AZ_EXE!" group show --name ${env.AZURE_RESOURCE_GROUP} >nul 2>&1
                            if !ERRORLEVEL! neq 0 (
                                echo Creating Resource Group: ${env.AZURE_RESOURCE_GROUP}
                                call "!AZ_EXE!" group create --name ${env.AZURE_RESOURCE_GROUP} --location ${env.AZURE_LOCATION}
                            )

                            :: Ensure Vault exists
                            call "!AZ_EXE!" keyvault show --name ${env.AZURE_VAULT_NAME} >nul 2>&1
                            if !ERRORLEVEL! neq 0 (
                                echo Creating Key Vault: ${env.AZURE_VAULT_NAME}
                                call "!AZ_EXE!" keyvault create --name ${env.AZURE_VAULT_NAME} --resource-group ${env.AZURE_RESOURCE_GROUP} --location ${env.AZURE_LOCATION} --enable-rbac-authorization true
                                if !ERRORLEVEL! neq 0 (
                                    echo ERROR: Failed to create Key Vault '${env.AZURE_VAULT_NAME}'.
                                    exit /b 1
                                )
                                echo Waiting 30 seconds for DNS propagation...
                                timeout /t 30 /nobreak
                            )

                            :: Handle Permissions
                            call "!AZ_EXE!" keyvault secret set --vault-name ${env.AZURE_VAULT_NAME} --name "test-permission" --value "test" >nul 2>&1
                            if !ERRORLEVEL! neq 0 (
                                echo [INFO] Service Principal lacks permission. Attempting to grant...
                                for /f "tokens=*" %%i in ('"!AZ_EXE!" ad sp show --id %ARM_CLIENT_ID% --query id --output tsv 2^>nul') do set SP_OID=%%i
                                if "!SP_OID!" neq "" (
                                    call "!AZ_EXE!" role assignment create --role "Key Vault Secrets Officer" --assignee !SP_OID! --scope /subscriptions/${env.AZURE_SUBSCRIPTION_ID}/resourceGroups/${env.AZURE_RESOURCE_GROUP}/providers/Microsoft.KeyVault/vaults/${env.AZURE_VAULT_NAME} >nul 2>&1
                                    if !ERRORLEVEL! equ 0 (
                                        echo [SUCCESS] Permission granted. Waiting for propagation...
                                        timeout /t 20 /nobreak
                                    )
                                )
                            )
                            
                            echo Storing secret...
                            call "!AZ_EXE!" keyvault secret set --vault-name ${env.AZURE_VAULT_NAME} --name %KEY_NAME%-secret --file private_key.pem
                        )
                        """
                        env.AWS_PRIVATE_KEY_FILE = "${WORKSPACE}\\private_key.pem"
                    }
                }
            }
        }

        stage('Build Images') {
            steps {
                script {
                    def onlyTargets = []
                        if (params.CLOUD_PROVIDER == 'ALL' || params.CLOUD_PROVIDER == 'AWS') onlyTargets.add("amazon-ebs.aws_linux")
                        if (params.CLOUD_PROVIDER == 'ALL' || params.CLOUD_PROVIDER == 'GCP') onlyTargets.add("googlecompute.gcp_linux")
                        if (params.CLOUD_PROVIDER == 'ALL' || params.CLOUD_PROVIDER == 'AZURE') onlyTargets.add("azure-arm.azure_linux")
                    
                    if (onlyTargets.isEmpty()) error "No clouds selected for build."
                    
                    def onlyFlag = "--only=${onlyTargets.join(',')}"

                    withCredentials([
                        usernamePassword(credentialsId: 'aws-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY'),
                        file(credentialsId: 'gcp-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS'),
                        usernamePassword(credentialsId: 'azure-creds', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET')
                    ]) {
                        bat """
                        @echo off
                        set AWS_ACCESS_KEY_ID=%AWS_ACCESS_KEY_ID%
                        set AWS_SECRET_ACCESS_KEY=%AWS_SECRET_ACCESS_KEY%
                        set GOOGLE_APPLICATION_CREDENTIALS=%GOOGLE_APPLICATION_CREDENTIALS%
                        set ARM_CLIENT_ID=%ARM_CLIENT_ID%
                        set ARM_CLIENT_SECRET=%ARM_CLIENT_SECRET%
                        
                        packer.exe build ^
                            -var "image_name=${params.IMAGE_NAME}" ^
                            -var "region=${env.AWS_REGION}" ^
                            -var "aws_key_name=%KEY_NAME%" ^
                            -var "aws_private_key_file=%AWS_PRIVATE_KEY_FILE%" ^
                            -var "gcp_project=${env.GCP_PROJECT}" ^
                            -var "gcp_zone=${env.GCP_ZONE}" ^
                            -var "azure_resource_group=${env.AZURE_RESOURCE_GROUP}" ^
                            -var "azure_subscription_id=${env.AZURE_SUBSCRIPTION_ID}" ^
                            -var "azure_tenant_id=${env.AZURE_TENANT_ID}" ^
                            -var "azure_client_id=%ARM_CLIENT_ID%" ^
                            -var "azure_client_secret=%ARM_CLIENT_SECRET%" ^
                            ${onlyFlag} ^
                            %PACKER_TEMPLATE%
                        """
                    }
                }
            }
        }

        stage('Extract Artifacts') {
            steps {
                script {
                    if (fileExists('manifest.json')) {
                        def manifest = readJSON file: 'manifest.json'
                        manifest.builds.each { build ->
                            if (build.name.contains("aws")) env.AMI_ID = build.artifact_id.split(':')[1]
                            if (build.name.contains("gcp")) env.GCP_IMAGE = build.artifact_id.split('/')[-1]
                            if (build.name.contains("azure")) env.AZURE_IMAGE = build.artifact_id
                        }
                        echo "Artifacts: AWS=${env.AMI_ID}, GCP=${env.GCP_IMAGE}, Azure=${env.AZURE_IMAGE}"
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                def body = "New images created:\n"
                if (env.AMI_ID) body += "AWS AMI: ${env.AMI_ID}\n"
                if (env.GCP_IMAGE) body += "GCP Image: ${env.GCP_IMAGE}\n"
                if (env.AZURE_IMAGE) body += "Azure Image: ${env.AZURE_IMAGE}\n"
                body += "\nPrivate Key stored in Cloud Secret Managers as: ${env.KEY_NAME}-secret"
                
                emailext(
                    subject: "Multi-Cloud Build Success - ${BUILD_NUMBER}",
                    body: body,
                    to: "${params.EMAIL}"
                )
            }
        }
        always {
            script {
                if (fileExists('private_key.pem')) bat "del private_key.pem"
                if (fileExists('private_key.pem.pub')) bat "del private_key.pem.pub"
            }
            archiveArtifacts artifacts: 'manifest.json', allowEmptyArchive: true
        }
    }
}
