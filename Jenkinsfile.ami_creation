def PACKER = 'C:\\DevopsProject\\packer.exe'

pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_NAME', defaultValue: 'multi-cloud-ubuntu', description: 'Name for the Packer image')
        string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'AWS region')
        string(name: 'GCP_PROJECT', defaultValue: 'packer-demo-456789', description: 'GCP project ID')
        string(name: 'GCP_ZONE', defaultValue: 'us-central1-a', description: 'GCP zone')
        string(name: 'AZURE_LOCATION', defaultValue: 'eastus', description: 'Azure region for resource creation')
        string(name: 'AZURE_VAULT_NAME', defaultValue: 'packer-vault', description: 'Azure Key Vault name')
        string(name: 'AZURE_RESOURCE_GROUP', defaultValue: 'packer-resources', description: 'Azure resource group')
        string(name: 'AZURE_SUBSCRIPTION_ID', defaultValue: 'b943e408-73c1-4cea-b780-689120606f67', description: 'Azure subscription ID')
        string(name: 'AZURE_TENANT_ID', defaultValue: '8344e416-02b8-4b70-a912-1995cc408f19', description: 'Azure tenant ID')
        string(name: 'EMAIL', defaultValue: 'mounika.b5693@outlook.com', description: 'Email for notification')
        booleanParam(name: 'BUILD_AWS', defaultValue: true, description: 'Build AWS AMI')
        booleanParam(name: 'BUILD_GCP', defaultValue: true, description: 'Build GCP Image')
        booleanParam(name: 'BUILD_AZURE', defaultValue: true, description: 'Build Azure Image')
    }

    environment {
        PACKER_TEMPLATE = 'aws-ubuntu.pkr.hcl'
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                git branch: 'main',
                      credentialsId: 'github-token',
                      url: 'https://github.com/MounikaB-jenkins/multi-cloud-packer.git'
            }
        }

        stage('Init & Validate') {
            steps {
                bat """
                @echo off
                if exist "C:\\DevopsProject\\packer.exe" (
                    copy /Y "C:\\DevopsProject\\packer.exe" .\\packer.exe
                ) else (
                    echo ERROR: Packer executable not found at C:\\DevopsProject\\packer.exe
                    exit /b 1
                )
                packer.exe init .
                packer.exe validate %PACKER_TEMPLATE%
                """
            }
        }

        stage('Setup and Store Keys') {
            steps {
                script {
                    env.KEY_NAME = "prod-key-${BUILD_NUMBER}"
                    withCredentials([
                        usernamePassword(credentialsId: 'aws-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY'),
                        file(credentialsId: 'gcp-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS'),
                        usernamePassword(credentialsId: 'azure-creds', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET')
                    ]) {
                        bat """
                        @echo off
                        setlocal enabledelayedexpansion
                        
                        echo [INFO] Searching for Cloud SDKs...
                        
                        :: Define common paths for gcloud
                        set "GCP_SEARCH_PATHS=C:\\google-cloud-sdk\\bin;C:\\Program Files\\Google\\Cloud SDK\\google-cloud-sdk\\bin;C:\\Program Files (x86)\\Google\\Cloud SDK\\google-cloud-sdk\\bin;%LocalAppData%\\Google\\Cloud SDK\\google-cloud-sdk\\bin;C:\\Program Files\\Google\\Cloud SDK\\bin;C:\\Program Files (x86)\\Google\\Cloud SDK\\bin"
                        
                        :: Define common paths for Azure CLI
                        set "AZ_SEARCH_PATHS=C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\wbin;C:\\Program Files (x86)\\Microsoft SDKs\\Azure\\CLI2\\wbin;C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\bin;C:\\Program Files (x86)\\Microsoft SDKs\\Azure\\CLI2\\bin"

                        :: Inject paths if tools are not found
                        where gcloud >nul 2>&1
                        if !ERRORLEVEL! neq 0 (
                            for %%p in (%GCP_SEARCH_PATHS%) do (
                                if exist "%%~p\\gcloud.cmd" (
                                    set "PATH=!PATH!;%%~p"
                                    echo [INFO] Found gcloud in %%~p
                                )
                            )
                        )

                        where az >nul 2>&1
                        if !ERRORLEVEL! neq 0 (
                            for %%p in (%AZ_SEARCH_PATHS%) do (
                                if exist "%%~p\\az.cmd" (
                                    set "PATH=!PATH!;%%~p"
                                    echo [INFO] Found az in %%~p
                                )
                            )
                        )

                        echo Generating SSH keypair...
                        ssh-keygen -t rsa -b 2048 -f private_key.pem -N ""
                        
                        :: AWS Storage
                        echo Storing key in AWS Secrets Manager...
                        set AWS_ACCESS_KEY_ID=%AWS_ACCESS_KEY_ID%
                        set AWS_SECRET_ACCESS_KEY=%AWS_SECRET_ACCESS_KEY%
                        call aws ec2 import-key-pair --key-name %KEY_NAME% --public-key-material fileb://private_key.pem.pub --region ${params.AWS_REGION}
                        call aws secretsmanager create-secret --name %KEY_NAME%-secret --secret-string file://private_key.pem --region ${params.AWS_REGION}
                        
                        :: GCP Storage
                        if "${params.BUILD_GCP}"=="true" (
                            echo Storing key in GCP Secret Manager...
                            set GOOGLE_APPLICATION_CREDENTIALS=%GOOGLE_APPLICATION_CREDENTIALS%
                            where gcloud >nul 2>&1
                            if !ERRORLEVEL! neq 0 (
                                echo ERROR: gcloud CLI not found. Checked common paths.
                                exit /b 1
                            )
                            call gcloud secrets create %KEY_NAME%-secret --replication-policy="automatic" --project=${params.GCP_PROJECT} 2>nul
                            call gcloud secrets versions add %KEY_NAME%-secret --data-file=private_key.pem --project=${params.GCP_PROJECT}
                        )
                        
                        :: Azure Storage
                        if "${params.BUILD_AZURE}"=="true" (
                            echo Storing key in Azure Key Vault...
                            set ARM_CLIENT_ID=%ARM_CLIENT_ID%
                            set ARM_CLIENT_SECRET=%ARM_CLIENT_SECRET%
                            where az >nul 2>&1
                            if !ERRORLEVEL! neq 0 (
                                echo ERROR: Azure CLI (az) not found. Checked common paths.
                                exit /b 1
                            )
                            call az login --service-principal -u %ARM_CLIENT_ID% -p %ARM_CLIENT_SECRET% --tenant ${params.AZURE_TENANT_ID}
                            call az account set --subscription ${params.AZURE_SUBSCRIPTION_ID}
                            
                            :: Ensure Resource Group exists
                            call az group show --name ${params.AZURE_RESOURCE_GROUP} >nul 2>&1
                            if !ERRORLEVEL! neq 0 (
                                echo Creating Resource Group: ${params.AZURE_RESOURCE_GROUP}
                                call az group create --name ${params.AZURE_RESOURCE_GROUP} --location ${params.AZURE_LOCATION}
                            )

                            :: Ensure Vault exists
                            call az keyvault show --name ${params.AZURE_VAULT_NAME} >nul 2>&1
                            if !ERRORLEVEL! neq 0 (
                                echo Creating Key Vault: ${params.AZURE_VAULT_NAME}
                                call az keyvault create --name ${params.AZURE_VAULT_NAME} --resource-group ${params.AZURE_RESOURCE_GROUP} --location ${params.AZURE_LOCATION} --enable-rbac-authorization true
                                if !ERRORLEVEL! neq 0 (
                                    echo ERROR: Failed to create Key Vault '${params.AZURE_VAULT_NAME}'.
                                    exit /b 1
                                )
                                echo Waiting 30 seconds for DNS propagation...
                                timeout /t 30 /nobreak
                            )

                            :: Handle Permissions
                            call az keyvault secret set --vault-name ${params.AZURE_VAULT_NAME} --name "test-permission" --value "test" >nul 2>&1
                            if !ERRORLEVEL! neq 0 (
                                echo [INFO] Service Principal lacks permission. Attempting to grant...
                                for /f "tokens=*" %%i in ('az ad sp show --id %ARM_CLIENT_ID% --query id --output tsv 2^>nul') do set SP_OID=%%i
                                if "!SP_OID!" neq "" (
                                    call az role assignment create --role "Key Vault Secrets Officer" --assignee !SP_OID! --scope /subscriptions/${params.AZURE_SUBSCRIPTION_ID}/resourceGroups/${params.AZURE_RESOURCE_GROUP}/providers/Microsoft.KeyVault/vaults/${params.AZURE_VAULT_NAME} >nul 2>&1
                                    if !ERRORLEVEL! equ 0 (
                                        echo [SUCCESS] Permission granted. Waiting for propagation...
                                        timeout /t 20 /nobreak
                                    )
                                )
                            )
                            
                            echo Storing secret...
                            call az keyvault secret set --vault-name ${params.AZURE_VAULT_NAME} --name %KEY_NAME%-secret --file private_key.pem
                        )
                        """
                        env.AWS_PRIVATE_KEY_FILE = "${WORKSPACE}\\private_key.pem"
                    }
                }
            }
        }

        stage('Build Images') {
            steps {
                script {
                    def onlyTargets = []
                    if (params.BUILD_AWS) onlyTargets.add("amazon-ebs.aws_linux")
                    if (params.BUILD_GCP) onlyTargets.add("googlecompute.gcp_linux")
                    if (params.BUILD_AZURE) onlyTargets.add("azure-arm.azure_linux")
                    
                    if (onlyTargets.isEmpty()) error "No clouds selected for build."
                    
                    def onlyFlag = "--only=${onlyTargets.join(',')}"

                    withCredentials([
                        usernamePassword(credentialsId: 'aws-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY'),
                        file(credentialsId: 'gcp-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS'),
                        usernamePassword(credentialsId: 'azure-creds', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET')
                    ]) {
                        bat """
                        @echo off
                        set AWS_ACCESS_KEY_ID=%AWS_ACCESS_KEY_ID%
                        set AWS_SECRET_ACCESS_KEY=%AWS_SECRET_ACCESS_KEY%
                        set GOOGLE_APPLICATION_CREDENTIALS=%GOOGLE_APPLICATION_CREDENTIALS%
                        set ARM_CLIENT_ID=%ARM_CLIENT_ID%
                        set ARM_CLIENT_SECRET=%ARM_CLIENT_SECRET%
                        
                        packer.exe build ^
                            -var "image_name=${params.IMAGE_NAME}" ^
                            -var "region=${params.AWS_REGION}" ^
                            -var "aws_key_name=%KEY_NAME%" ^
                            -var "aws_private_key_file=%AWS_PRIVATE_KEY_FILE%" ^
                            -var "gcp_project=${params.GCP_PROJECT}" ^
                            -var "gcp_zone=${params.GCP_ZONE}" ^
                            -var "azure_resource_group=${params.AZURE_RESOURCE_GROUP}" ^
                            -var "azure_subscription_id=${params.AZURE_SUBSCRIPTION_ID}" ^
                            -var "azure_tenant_id=${params.AZURE_TENANT_ID}" ^
                            -var "azure_client_id=%ARM_CLIENT_ID%" ^
                            -var "azure_client_secret=%ARM_CLIENT_SECRET%" ^
                            ${onlyFlag} ^
                            %PACKER_TEMPLATE%
                        """
                    }
                }
            }
        }

        stage('Extract Artifacts') {
            steps {
                script {
                    if (fileExists('manifest.json')) {
                        def manifest = readJSON file: 'manifest.json'
                        manifest.builds.each { build ->
                            if (build.name.contains("aws")) env.AMI_ID = build.artifact_id.split(':')[1]
                            if (build.name.contains("gcp")) env.GCP_IMAGE = build.artifact_id.split('/')[-1]
                            if (build.name.contains("azure")) env.AZURE_IMAGE = build.artifact_id
                        }
                        echo "Artifacts: AWS=${env.AMI_ID}, GCP=${env.GCP_IMAGE}, Azure=${env.AZURE_IMAGE}"
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                def body = "New images created:\n"
                if (env.AMI_ID) body += "AWS AMI: ${env.AMI_ID}\n"
                if (env.GCP_IMAGE) body += "GCP Image: ${env.GCP_IMAGE}\n"
                if (env.AZURE_IMAGE) body += "Azure Image: ${env.AZURE_IMAGE}\n"
                body += "\nPrivate Key stored in Cloud Secret Managers as: ${env.KEY_NAME}-secret"
                
                emailext(
                    subject: "Multi-Cloud Build Success - ${BUILD_NUMBER}",
                    body: body,
                    to: "${params.EMAIL}"
                )
            }
        }
        always {
            script {
                if (fileExists('private_key.pem')) bat "del private_key.pem"
                if (fileExists('private_key.pem.pub')) bat "del private_key.pem.pub"
            }
            archiveArtifacts artifacts: 'manifest.json', allowEmptyArchive: true
        }
    }
}
