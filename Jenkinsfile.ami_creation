def PACKER = 'C:\\DevopsProject\\packer.exe'

properties([
    parameters([
        choice(name: 'CLOUD_PROVIDER', choices: ['ALL', 'AWS', 'GCP', 'AZURE'], description: 'Select cloud provider(s) to build images for'),
        string(name: 'BRANCH_NAME', defaultValue: 'develop', description: 'Git branch to checkout and build (e.g., development, main, feature/xyz)'),
        string(name: 'IMAGE_NAME', defaultValue: 'multi-cloud-ubuntu', description: 'Name for the Packer image'),
        string(name: 'EMAIL', defaultValue: 'mounika.b5693@outlook.com', description: 'Email for notification'),
        
        // Dynamic Parameters that render ONLY if their respective cloud is selected
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'AWS Region', name: 'AWS_REGION', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "AWS" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'us-east-1\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'us-east-1\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'GCP Project ID', name: 'GCP_PROJECT', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "GCP" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'packer-demo-456789\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'packer-demo-456789\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'AWS Copy Regions (comma-separated)', name: 'AWS_COPY_REGIONS', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "AWS" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'AWS Share Account IDs (comma-separated)', name: 'AWS_SHARE_ACCOUNTS', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "AWS" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'GCP Zone', name: 'GCP_ZONE', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "GCP" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'us-central1-a\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'us-central1-a\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'GCP Storage Locations (comma-separated)', name: 'GCP_STORAGE_LOCATIONS', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "GCP" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'GCP Share Members (e.g. serviceAccount:user@gcp.com)', name: 'GCP_SHARE_MEMBERS', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "GCP" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'Azure Region', name: 'AZURE_LOCATION', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "AZURE" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'eastus\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'eastus\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'Azure Key Vault Name', name: 'AZURE_VAULT_NAME', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "AZURE" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'packer-vault\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'packer-vault\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'Azure Gallery Resource Group', name: 'AZURE_GALLERY_RG', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "AZURE" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'Azure Gallery Name', name: 'AZURE_GALLERY_NAME', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "AZURE" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'Azure Gallery Regions (comma-separated)', name: 'AZURE_GALLERY_REGIONS', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "AZURE" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'Azure Resource Group', name: 'AZURE_RESOURCE_GROUP', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "AZURE" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'packer-resources\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'packer-resources\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'Azure Subscription ID', name: 'AZURE_SUBSCRIPTION_ID', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "AZURE" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'b943e408-73c1-4cea-b780-689120606f67\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'b943e408-73c1-4cea-b780-689120606f67\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'Azure Tenant ID', name: 'AZURE_TENANT_ID', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "AZURE" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'8344e416-02b8-4b70-a912-1995cc408f19\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'8344e416-02b8-4b70-a912-1995cc408f19\'>" }']]],
        
        [$class: 'DynamicReferenceParameter', choiceType: 'ET_FORMATTED_HTML', description: 'Azure Share Target Object IDs (comma-separated)', name: 'AZURE_SHARE_OIDS', omitValueField: true, referencedParameters: 'CLOUD_PROVIDER', script: [$class: 'GroovyScript', fallbackScript: [classpath: [], sandbox: true, script: 'return "error"'], script: [classpath: [], sandbox: true, script: 'if (CLOUD_PROVIDER == "AZURE" || CLOUD_PROVIDER == "ALL") { return "<input type=\'text\' class=\'setting-input\' name=\'value\' value=\'\'>" } else { return "<i>N/A (Not required)</i><input type=\'hidden\' name=\'value\' value=\'\'>" }']]]
    ])
])

pipeline {
    agent any

    environment {
        PACKER_TEMPLATE = 'aws-ubuntu.pkr.hcl'
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                git branch: params.BRANCH_NAME,
                      credentialsId: 'github-token',
                      url: 'https://github.com/MounikaB-jenkins/multi-cloud-packer.git'
            }
        }

        stage('Init & Validate') {
            steps {
                script {
                if (isUnix()) {
                    sh """
                    packer init .
                    packer validate -var-file="dev.pkrvars.hcl" ${PACKER_TEMPLATE}
                    """
                } else {
                bat """
                @echo off
                if exist "C:\\DevopsProject\\packer.exe" (
                    copy /Y "C:\\DevopsProject\\packer.exe" .\\packer.exe
                ) else (
                    echo ERROR: Packer executable not found at C:\\DevopsProject\\packer.exe
                    exit /b 1
                )
                packer.exe init .
                packer.exe validate -var-file="dev.pkrvars.hcl" %PACKER_TEMPLATE%
                """
            }
                }
            }
        }

        stage('Setup and Store Keys') {
            steps {
                script {
                    env.KEY_NAME = "prod-key-${BUILD_NUMBER}"
                    withCredentials([
                        usernamePassword(credentialsId: 'aws-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY'),
                        file(credentialsId: 'gcp-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS'),
                        usernamePassword(credentialsId: 'azure-creds', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET')
                    ]) {
                        if (isUnix()) {
                            sh """
                            #!/bin/bash
                            ssh-keygen -t rsa -b 2048 -f private_key.pem -N ""
                            
                            if [ "${params.CLOUD_PROVIDER}" = "ALL" ] || [ "${params.CLOUD_PROVIDER}" = "AWS" ]; then
                                aws ec2 import-key-pair --key-name ${env.KEY_NAME} --public-key-material fileb://private_key.pem.pub --region ${params.AWS_REGION}
                                aws secretsmanager create-secret --name ${env.KEY_NAME}-secret --secret-string file://private_key.pem --region ${params.AWS_REGION}
                            fi
                            
                            if [ "${params.CLOUD_PROVIDER}" = "ALL" ] || [ "${params.CLOUD_PROVIDER}" = "GCP" ]; then
                                gcloud auth activate-service-account --key-file="\${GOOGLE_APPLICATION_CREDENTIALS}" --quiet
                                gcloud services enable secretmanager.googleapis.com --project=${params.GCP_PROJECT} --quiet
                                gcloud secrets create ${env.KEY_NAME}-secret --replication-policy="automatic" --project=${params.GCP_PROJECT} --quiet 2>/dev/null || true
                                gcloud secrets versions add ${env.KEY_NAME}-secret --data-file=private_key.pem --project=${params.GCP_PROJECT} --quiet
                            fi
                            
                            if [ "${params.CLOUD_PROVIDER}" = "ALL" ] || [ "${params.CLOUD_PROVIDER}" = "AZURE" ]; then
                                az login --service-principal -u \${ARM_CLIENT_ID} -p \${ARM_CLIENT_SECRET} --tenant ${params.AZURE_TENANT_ID} >/dev/null 2>&1
                                az account set --subscription ${params.AZURE_SUBSCRIPTION_ID}
                                
                                if ! az group show --name ${params.AZURE_RESOURCE_GROUP} >/dev/null 2>&1; then
                                    az group create --name ${params.AZURE_RESOURCE_GROUP} --location "${params.AZURE_LOCATION}"
                                fi
                                
                                if ! az keyvault show --name ${params.AZURE_VAULT_NAME} >/dev/null 2>&1; then
                                    az keyvault create --name ${params.AZURE_VAULT_NAME} --resource-group ${params.AZURE_RESOURCE_GROUP} --location "${params.AZURE_LOCATION}" --enable-rbac-authorization true
                                    sleep 30
                                fi
                                
                                if ! az keyvault secret set --vault-name ${params.AZURE_VAULT_NAME} --name "test-permission" --value "test" >/dev/null 2>&1; then
                                    az role assignment create --role "Key Vault Secrets Officer" --assignee \${ARM_CLIENT_ID} --scope "/subscriptions/${params.AZURE_SUBSCRIPTION_ID}/resourceGroups/${params.AZURE_RESOURCE_GROUP}/providers/Microsoft.KeyVault/vaults/${params.AZURE_VAULT_NAME}" || { echo "Role assignment failed"; exit 1; }
                                    sleep 60
                                fi
                                
                                az keyvault secret set --vault-name ${params.AZURE_VAULT_NAME} --name ${env.KEY_NAME}-secret --file private_key.pem
                            fi
                            """
                            env.AWS_PRIVATE_KEY_FILE = "${WORKSPACE}/private_key.pem"
                        } else {
                        bat """
                        @echo off
                        setlocal enabledelayedexpansion
                        
                        :: Prevent Python environment conflicts for Azure CLI globally in this script
                        set "PYTHONHOME="
                        set "PYTHONPATH="
                        set "PYTHONEXECUTABLE="
                        
                        echo [INFO] Searching for Cloud SDKs...

                        :: Find gcloud executable
                        set "GCLOUD_EXE="
                        where gcloud >nul 2>&1
                        if !ERRORLEVEL! equ 0 (
                            set "GCLOUD_EXE=gcloud"
                        ) else (
                            for %%p in ("C:\\Users\\vresh\\AppData\\Local\\Google\\Cloud SDK\\google-cloud-sdk\\bin" "C:\\Program Files (x86)\\Google\\Cloud SDK\\google-cloud-sdk\\bin" "C:\\Program Files\\Google\\Cloud SDK\\google-cloud-sdk\\bin" "%LocalAppData%\\Google\\Cloud SDK\\google-cloud-sdk\\bin") do (
                                if exist "%%~p\\gcloud.cmd" if "!GCLOUD_EXE!"=="" set "GCLOUD_EXE=%%~p\\gcloud.cmd"
                            )
                        )

                        :: Find az executable
                        set "AZ_EXE="
                        for %%p in ("C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\wbin" "C:\\Program Files (x86)\\Microsoft SDKs\\Azure\\CLI2\\wbin") do (
                            if exist "%%~p\\az.cmd" if "!AZ_EXE!"=="" set "AZ_EXE=%%~p\\az.cmd"
                        )
                        if "!AZ_EXE!"=="" (
                            where az >nul 2>&1
                            if !ERRORLEVEL! equ 0 set "AZ_EXE=az"
                        )

                        echo Generating SSH keypair...
                        ssh-keygen -t rsa -b 2048 -f private_key.pem -N ""
                        
                        :: AWS Storage
                        if "${params.CLOUD_PROVIDER}"=="ALL" set RUN_AWS=true
                        if "${params.CLOUD_PROVIDER}"=="AWS" set RUN_AWS=true
                        if "!RUN_AWS!"=="true" (
                            echo Storing key in AWS Secrets Manager...
                            set AWS_ACCESS_KEY_ID=%AWS_ACCESS_KEY_ID%
                            set AWS_SECRET_ACCESS_KEY=%AWS_SECRET_ACCESS_KEY%
                            call aws ec2 import-key-pair --key-name %KEY_NAME% --public-key-material fileb://private_key.pem.pub --region ${params.AWS_REGION}
                            call aws secretsmanager create-secret --name %KEY_NAME%-secret --secret-string file://private_key.pem --region ${params.AWS_REGION}
                        )
                        
                        :: GCP Storage
                        if "${params.CLOUD_PROVIDER}"=="ALL" set RUN_GCP=true
                        if "${params.CLOUD_PROVIDER}"=="GCP" set RUN_GCP=true
                        if "!RUN_GCP!"=="true" (
                            echo Storing key in GCP Secret Manager...
                            if "!GCLOUD_EXE!"=="" (
                                echo ERROR: gcloud CLI not found. Checked common paths.
                                exit /b 1
                            )
                            set GOOGLE_APPLICATION_CREDENTIALS=%GOOGLE_APPLICATION_CREDENTIALS%
                            echo Authenticating gcloud with service account...
                            call "!GCLOUD_EXE!" auth activate-service-account --key-file="%GOOGLE_APPLICATION_CREDENTIALS%" --quiet
                            echo Enabling Secret Manager API...
                            call "!GCLOUD_EXE!" services enable secretmanager.googleapis.com --project=${params.GCP_PROJECT} --quiet
                            call "!GCLOUD_EXE!" secrets create %KEY_NAME%-secret --replication-policy="automatic" --project=${params.GCP_PROJECT} --quiet 2>nul
                            call "!GCLOUD_EXE!" secrets versions add %KEY_NAME%-secret --data-file=private_key.pem --project=${params.GCP_PROJECT} --quiet
                        )
                        
                        :: Azure Storage
                        if "${params.CLOUD_PROVIDER}"=="ALL" set RUN_AZURE=true
                        if "${params.CLOUD_PROVIDER}"=="AZURE" set RUN_AZURE=true
                        if "!RUN_AZURE!"=="true" (
                            echo Storing key in Azure Key Vault...
                            if "!AZ_EXE!"=="" (
                                echo ERROR: Azure CLI 'az' not found. Checked common paths.
                                exit /b 1
                            )
                            
                            set ARM_CLIENT_ID=%ARM_CLIENT_ID%
                            set ARM_CLIENT_SECRET=%ARM_CLIENT_SECRET%
                            call "!AZ_EXE!" login --service-principal -u %ARM_CLIENT_ID% -p %ARM_CLIENT_SECRET% --tenant ${params.AZURE_TENANT_ID}
                            call "!AZ_EXE!" account set --subscription ${params.AZURE_SUBSCRIPTION_ID}
                            
                            :: Ensure Resource Group exists
                            call "!AZ_EXE!" group show --name ${params.AZURE_RESOURCE_GROUP} >nul 2>&1
                            if !ERRORLEVEL! neq 0 (
                                echo Creating Resource Group: ${params.AZURE_RESOURCE_GROUP}
                                call "!AZ_EXE!" group create --name ${params.AZURE_RESOURCE_GROUP} --location ${params.AZURE_LOCATION}
                            )

                            :: Ensure Vault exists
                            call "!AZ_EXE!" keyvault show --name ${params.AZURE_VAULT_NAME} >nul 2>&1
                            if !ERRORLEVEL! neq 0 (
                                echo Creating Key Vault: ${params.AZURE_VAULT_NAME}
                                call "!AZ_EXE!" keyvault create --name ${params.AZURE_VAULT_NAME} --resource-group ${params.AZURE_RESOURCE_GROUP} --location ${params.AZURE_LOCATION} --enable-rbac-authorization true
                                if !ERRORLEVEL! neq 0 (
                                    echo ERROR: Failed to create Key Vault '${params.AZURE_VAULT_NAME}'.
                                    exit /b 1
                                )
                                echo Waiting 30 seconds for DNS propagation...
                                ping 127.0.0.1 -n 31 > nul
                            )

                            :: Handle Permissions
                            call "!AZ_EXE!" keyvault secret set --vault-name ${params.AZURE_VAULT_NAME} --name "test-permission" --value "test" >nul 2>&1
                            if !ERRORLEVEL! neq 0 (
                                echo [INFO] Service Principal lacks permission. Attempting to grant 'Key Vault Secrets Officer' role...
                                call "!AZ_EXE!" role assignment create --role "Key Vault Secrets Officer" --assignee %ARM_CLIENT_ID% --scope "/subscriptions/${params.AZURE_SUBSCRIPTION_ID}/resourceGroups/${params.AZURE_RESOURCE_GROUP}/providers/Microsoft.KeyVault/vaults/${params.AZURE_VAULT_NAME}"
                                if !ERRORLEVEL! equ 0 (
                                    echo [SUCCESS] Permission granted. Waiting 60s for propagation...
                                    ping 127.0.0.1 -n 61 > nul
                                ) else (
                                    echo [ERROR] Role assignment failed. Your Service Principal must have 'Owner' or 'Role Based Access Control Administrator' permissions to grant itself Key Vault access.
                                    exit /b 1
                                )
                            )
                            
                            echo Storing secret...
                            call "!AZ_EXE!" keyvault secret set --vault-name ${params.AZURE_VAULT_NAME} --name %KEY_NAME%-secret --file private_key.pem
                        )
                        """
                        env.AWS_PRIVATE_KEY_FILE = "${WORKSPACE}\\private_key.pem"
                        }
                    }
                }
            }
        }

        stage('Build Images') {
            steps {
                script {
                    def onlyTargets = []
                        if (params.CLOUD_PROVIDER == 'ALL' || params.CLOUD_PROVIDER == 'AWS') onlyTargets.add("amazon-ebs.aws_linux")
                        if (params.CLOUD_PROVIDER == 'ALL' || params.CLOUD_PROVIDER == 'GCP') onlyTargets.add("googlecompute.gcp_linux")
                        if (params.CLOUD_PROVIDER == 'ALL' || params.CLOUD_PROVIDER == 'AZURE') onlyTargets.add("azure-arm.azure_linux")
                    
                    if (onlyTargets.isEmpty()) error "No clouds selected for build."
                    
                    def onlyFlag = "--only=${onlyTargets.join(',')}"

                    // Only set PKR_VARs if Jenkins parameters are provided (allows dev.pkrvars.hcl to act as default)
                    if (params.AWS_COPY_REGIONS) env.PKR_VAR_aws_ami_regions = "[\"${params.AWS_COPY_REGIONS.split(',').collect{it.trim()}.join('\",\"')}\"]"
                    if (params.AWS_SHARE_ACCOUNTS) env.PKR_VAR_aws_ami_users = "[\"${params.AWS_SHARE_ACCOUNTS.split(',').collect{it.trim()}.join('\",\"')}\"]"
                    
                    if (params.GCP_STORAGE_LOCATIONS) env.PKR_VAR_gcp_storage_locations = "[\"${params.GCP_STORAGE_LOCATIONS.split(',').collect{it.trim()}.join('\",\"')}\"]"
                    if (params.AZURE_GALLERY_RG) env.PKR_VAR_azure_gallery_rg = params.AZURE_GALLERY_RG
                    if (params.AZURE_GALLERY_NAME) env.PKR_VAR_azure_gallery_name = params.AZURE_GALLERY_NAME
                    if (params.AZURE_GALLERY_REGIONS) env.PKR_VAR_azure_gallery_regions = "[\"${params.AZURE_GALLERY_REGIONS.split(',').collect{it.trim()}.join('\",\"')}\"]"

                    withCredentials([
                        usernamePassword(credentialsId: 'aws-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY'),
                        file(credentialsId: 'gcp-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS'),
                        usernamePassword(credentialsId: 'azure-creds', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET')
                    ]) {
                        if (isUnix()) {
                            sh """
                            packer build \\
                                -var "image_name=${params.IMAGE_NAME}" \\
                                -var "region=${params.AWS_REGION}" \\
                                -var "aws_key_name=${env.KEY_NAME}" \\
                                -var "aws_private_key_file=${env.AWS_PRIVATE_KEY_FILE}" \\
                                -var "gcp_project=${params.GCP_PROJECT}" \\
                                -var "gcp_zone=${params.GCP_ZONE}" \\
                                -var "azure_resource_group=${params.AZURE_RESOURCE_GROUP}" \\
                                -var "azure_subscription_id=${params.AZURE_SUBSCRIPTION_ID}" \\
                                -var "azure_tenant_id=${params.AZURE_TENANT_ID}" \\
                                -var "azure_client_id=\${ARM_CLIENT_ID}" \\
                                -var "azure_client_secret=\${ARM_CLIENT_SECRET}" \\
                                -var-file="dev.pkrvars.hcl" \\
                                ${onlyFlag} \\
                                ${PACKER_TEMPLATE}
                            """
                        } else {
                        bat """
                        @echo off
                        set AWS_ACCESS_KEY_ID=%AWS_ACCESS_KEY_ID%
                        set AWS_SECRET_ACCESS_KEY=%AWS_SECRET_ACCESS_KEY%
                        set GOOGLE_APPLICATION_CREDENTIALS=%GOOGLE_APPLICATION_CREDENTIALS%
                        set ARM_CLIENT_ID=%ARM_CLIENT_ID%
                        set ARM_CLIENT_SECRET=%ARM_CLIENT_SECRET%
                        
                        packer.exe build ^
                            -var "image_name=${params.IMAGE_NAME}" ^
                            -var "region=${params.AWS_REGION}" ^
                            -var "aws_key_name=%KEY_NAME%" ^
                            -var "aws_private_key_file=%AWS_PRIVATE_KEY_FILE%" ^
                            -var "gcp_project=${params.GCP_PROJECT}" ^
                            -var "gcp_zone=${params.GCP_ZONE}" ^
                            -var "azure_resource_group=${params.AZURE_RESOURCE_GROUP}" ^
                            -var "azure_subscription_id=${params.AZURE_SUBSCRIPTION_ID}" ^
                            -var "azure_tenant_id=${params.AZURE_TENANT_ID}" ^
                            -var "azure_client_id=%ARM_CLIENT_ID%" ^
                            -var "azure_client_secret=%ARM_CLIENT_SECRET%" ^
                            -var-file="dev.pkrvars.hcl" ^
                            ${onlyFlag} ^
                            %PACKER_TEMPLATE%
                        """
                        }
                    }
                }
            }
        }

        stage('Extract Artifacts') {
            steps {
                script {
                    if (fileExists('manifest.json')) {
                        def manifest = readJSON file: 'manifest.json'
                        manifest.builds.each { build ->
                            if (build.name.contains("aws")) env.AMI_ID = build.artifact_id.split(':')[1]
                            if (build.name.contains("gcp")) env.GCP_IMAGE = build.artifact_id.split('/')[-1]
                            if (build.name.contains("azure")) env.AZURE_IMAGE = build.artifact_id
                        }
                        echo "Artifacts: AWS=${env.AMI_ID}, GCP=${env.GCP_IMAGE}, Azure=${env.AZURE_IMAGE}"
                    }
                }
            }
        }

        stage('Share Cross-Account Images') {
            when {
                expression { params.GCP_SHARE_MEMBERS != '' || params.AZURE_SHARE_OIDS != '' }
            }
            steps {
                script {
                    withCredentials([
                        file(credentialsId: 'gcp-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS'),
                        usernamePassword(credentialsId: 'azure-creds', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET')
                    ]) {
                        if (env.GCP_IMAGE && params.GCP_SHARE_MEMBERS) {
                            if (isUnix()) {
                                sh """
                                gcloud auth activate-service-account --key-file="\${GOOGLE_APPLICATION_CREDENTIALS}" --quiet
                                for M in \$(echo "${params.GCP_SHARE_MEMBERS}" | tr ',' ' '); do
                                    echo "Granting GCP image access to \$M..."
                                    gcloud compute images add-iam-policy-binding ${env.GCP_IMAGE} --project=${params.GCP_PROJECT} --member="\$M" --role="roles/compute.imageUser" --quiet
                                done
                                """
                            } else {
                            bat """
                            @echo off
                            set GOOGLE_APPLICATION_CREDENTIALS=%GOOGLE_APPLICATION_CREDENTIALS%
                            call gcloud auth activate-service-account --key-file="%GOOGLE_APPLICATION_CREDENTIALS%" --quiet
                            for %%M in (${params.GCP_SHARE_MEMBERS.replace(',', ' ')}) do (
                                echo Granting GCP image access to %%M...
                                call gcloud compute images add-iam-policy-binding ${env.GCP_IMAGE} --project=${params.GCP_PROJECT} --member="%%M" --role="roles/compute.imageUser" --quiet
                            )
                            """
                            }
                        }
                        if (env.AZURE_IMAGE && params.AZURE_SHARE_OIDS) {
                            if (isUnix()) {
                                sh """
                                az login --service-principal -u \${ARM_CLIENT_ID} -p \${ARM_CLIENT_SECRET} --tenant ${params.AZURE_TENANT_ID} >/dev/null 2>&1
                                az account set --subscription ${params.AZURE_SUBSCRIPTION_ID}
                                for O in \$(echo "${params.AZURE_SHARE_OIDS}" | tr ',' ' '); do
                                    echo "Granting Azure Reader access to Object ID \$O..."
                                    az role assignment create --role "Reader" --assignee "\$O" --scope "${env.AZURE_IMAGE}"
                                done
                                """
                            } else {
                            bat """
                            @echo off
                            call az login --service-principal -u %ARM_CLIENT_ID% -p %ARM_CLIENT_SECRET% --tenant ${params.AZURE_TENANT_ID} >nul 2>&1
                            call az account set --subscription ${params.AZURE_SUBSCRIPTION_ID}
                            for %%O in (${params.AZURE_SHARE_OIDS.replace(',', ' ')}) do (
                                echo Granting Azure Reader access to Object ID %%O...
                                call az role assignment create --role "Reader" --assignee %%O --scope "${env.AZURE_IMAGE}"
                            )
                            """
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                def body = "New images created:\n"
                if (env.AMI_ID) body += "AWS AMI: ${env.AMI_ID}\n"
                if (env.GCP_IMAGE) body += "GCP Image: ${env.GCP_IMAGE}\n"
                if (env.AZURE_IMAGE) body += "Azure Image: ${env.AZURE_IMAGE}\n"
                body += "\nPrivate Key stored in Cloud Secret Managers as: ${env.KEY_NAME}-secret"
                
                emailext(
                    subject: "Multi-Cloud Build Success - ${BUILD_NUMBER}",
                    body: body,
                    to: "${params.EMAIL}"
                )
            }
        }
        always {
            script {
                if (fileExists('private_key.pem')) { isUnix() ? sh("rm -f private_key.pem") : bat("del private_key.pem") }
                if (fileExists('private_key.pem.pub')) { isUnix() ? sh("rm -f private_key.pem.pub") : bat("del private_key.pem.pub") }
            }
            archiveArtifacts artifacts: 'manifest.json', allowEmptyArchive: true
        }
    }
}
