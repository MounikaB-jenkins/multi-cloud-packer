pipeline {
    agent any

    parameters {
        // Connection Parameters
        string(name: 'PRIVATE_IP', defaultValue: '', description: 'Private IP of the EC2/GCP/Azure instance running MongoDB.')
        string(name: 'BASTION_IP', defaultValue: '', description: 'Public IP of the Bastion Host. (Leave empty if connecting directly).')
        string(name: 'SSH_USER', defaultValue: 'ec2-user', description: 'SSH username for the instances (e.g., ec2-user or ubuntu).')
        choice(name: 'CLOUD', choices: ['AWS', 'GCP', 'AZURE'], description: 'Cloud provider where your SSH key is stored.')
        string(name: 'SECRET_NAME', defaultValue: '', description: 'Name of the secret containing the SSH key (e.g., prod-key-1-secret).')
        
        // MongoDB Operations
        choice(name: 'MONGO_ACTION', choices: [
            'CHECK_STATUS',
            'START_SERVER',
            'STOP_SERVER',
            'LIST_DATABASES', 
            'CREATE_DATABASE', 
            'DELETE_DATABASE',
            'LIST_COLLECTIONS', 
            'CREATE_COLLECTION', 
            'UPDATE_COLLECTION',
            'DELETE_COLLECTION',
            'INSERT_DOCUMENT', 
            'UPDATE_DOCUMENT', 
            'DELETE_DOCUMENT'
        ], description: 'MongoDB operation to perform.')
        
        string(name: 'DB_NAME', defaultValue: '', description: 'Target Database Name (e.g., bankingdb). Required for most operations. If provided during LIST_DATABASES, it acts as a search filter.')
        string(name: 'COLLECTION_NAME', defaultValue: '', description: 'Target Collection Name (e.g., customers). If provided during LIST_COLLECTIONS, it acts as a search filter.')
        string(name: 'NEW_COLLECTION_NAME', defaultValue: '', description: 'New Collection Name (e.g., archived_customers). Used only for the UPDATE_COLLECTION action.')
        
        string(name: 'DOC_FILTER', defaultValue: '{}', description: 'JSON Filter for Update/Delete operations (e.g., { "name": "John" }).')
        string(name: 'DOC_PAYLOAD', defaultValue: '{}', description: 'JSON Payload for Insert/Update operations (e.g., { "status": "active" } or { "$set": { "status": "active" } }).')

        // Cloud Configuration
        string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'AWS region (if using AWS).')
        string(name: 'GCP_PROJECT', defaultValue: 'packer-demo-456789', description: 'GCP project ID (if using GCP).')
        string(name: 'AZURE_VAULT_NAME', defaultValue: 'packer-vault', description: 'Azure Key Vault name (if using Azure).')
        string(name: 'AZURE_SUBSCRIPTION_ID', defaultValue: 'b943e408-73c1-4cea-b780-689120606f67', description: 'Azure subscription ID (if using Azure).')
        string(name: 'AZURE_TENANT_ID', defaultValue: '8344e416-02b8-4b70-a912-1995cc408f19', description: 'Azure tenant ID (if using Azure).')
    }

    stages {
        stage('Prepare Script') {
            steps {
                script {
                    if (params.PRIVATE_IP == '' || params.SECRET_NAME == '') {
                        error "PRIVATE_IP and SECRET_NAME are required to connect to the instance."
                    }
                    
                    // Retrieve MongoDB Credentials from AWS Secrets Manager
                    def mongoCredsText = ''
                    withCredentials([usernamePassword(credentialsId: 'aws-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                        if (isUnix()) {
                            mongoCredsText = sh(script: """
                            export AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
                            export AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
                            aws secretsmanager get-secret-value --secret-id mongodb-creds --query SecretString --output text --region ${params.AWS_REGION}
                            """, returnStdout: true).trim()
                        } else {
                            mongoCredsText = bat(script: """@echo off
                            set AWS_ACCESS_KEY_ID=%AWS_ACCESS_KEY_ID%
                            set AWS_SECRET_ACCESS_KEY=%AWS_SECRET_ACCESS_KEY%
                            aws secretsmanager get-secret-value --secret-id mongodb-creds --query SecretString --output text --region ${params.AWS_REGION}
                            """, returnStdout: true).trim()
                        }
                    }
                    
                    if (!mongoCredsText) {
                        error "MongoDB credentials secret is empty or failed to retrieve."
                    }
                    
                    def mongoUser = "mongodb_admin"
                    def mongoPass = mongoCredsText
                    try {
                        def mongoCreds = readJSON text: mongoCredsText
                        if (mongoCreds.username) mongoUser = mongoCreds.username
                        if (mongoCreds.password) mongoPass = mongoCreds.password
                    } catch (Exception e) {
                        echo "Warning: Secret is not valid JSON. Treating the entire secret string as the password."
                    }

                    writeFile file: 'tmp_user.txt', text: mongoUser.trim()
                    writeFile file: 'tmp_pass.txt', text: mongoPass.trim()
                    def mongoUserB64 = ""
                    def mongoPassB64 = ""
                    if (isUnix()) {
                        mongoUserB64 = sh(script: "tr -d '\\r\\n' < tmp_user.txt | base64 | tr -d '\\r\\n'", returnStdout: true).trim()
                        mongoPassB64 = sh(script: "tr -d '\\r\\n' < tmp_pass.txt | base64 | tr -d '\\r\\n'", returnStdout: true).trim()
                        sh "rm -f tmp_user.txt tmp_pass.txt"
                    } else {
                        mongoUserB64 = bat(script: "@powershell -NoProfile -Command \"[Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes((Get-Content -Path 'tmp_user.txt' -Raw).Trim()))\"", returnStdout: true).trim()
                        mongoPassB64 = bat(script: "@powershell -NoProfile -Command \"[Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes((Get-Content -Path 'tmp_pass.txt' -Raw).Trim()))\"", returnStdout: true).trim()
                        bat "del tmp_user.txt tmp_pass.txt"
                    }

                    def jsScript = ""
                    switch(params.MONGO_ACTION) {
                        case 'CHECK_STATUS':
                        case 'START_SERVER':
                        case 'STOP_SERVER':
                            break
                        case 'LIST_DATABASES':
                            jsScript = """
                            const dbs = db.adminCommand('listDatabases').databases;
                            const target = '${params.DB_NAME}';
                            if (target) {
                                const found = dbs.find(d => d.name === target);
                                if (found) print('Database found: ' + target);
                                else print('Database not found: ' + target);
                            } else {
                                print('--- All Databases ---');
                                dbs.forEach(d => print(d.name));
                            }
                            """
                            break
                        case 'CREATE_DATABASE':
                            // MongoDB databases are strictly created when a collection/document is inserted.
                            jsScript = """
                            use ${params.DB_NAME};
                            db.createCollection('${params.COLLECTION_NAME}' || 'init_collection');
                            print('Database ${params.DB_NAME} successfully created and initialized.');
                            """
                            break
                        case 'DELETE_DATABASE':
                            jsScript = """
                            use ${params.DB_NAME};
                            db.dropDatabase();
                            print('Database ${params.DB_NAME} successfully deleted.');
                            """
                            break
                        case 'LIST_COLLECTIONS':
                            jsScript = """
                            use ${params.DB_NAME};
                            const colls = db.getCollectionNames();
                            const target = '${params.COLLECTION_NAME}';
                            if (target) {
                                if (colls.includes(target)) print('Collection found: ' + target);
                                else print('Collection not found: ' + target);
                            } else {
                                print('--- Collections in ${params.DB_NAME} ---');
                                colls.forEach(c => print(c));
                            }
                            """
                            break
                        case 'CREATE_COLLECTION':
                            jsScript = """
                            use ${params.DB_NAME};
                            db.createCollection('${params.COLLECTION_NAME}');
                            print('Collection ${params.COLLECTION_NAME} created successfully.');
                            """
                            break
                        case 'UPDATE_COLLECTION':
                            jsScript = """
                            use ${params.DB_NAME};
                            db.${params.COLLECTION_NAME}.renameCollection('${params.NEW_COLLECTION_NAME}');
                            print('Collection ${params.COLLECTION_NAME} successfully renamed to ${params.NEW_COLLECTION_NAME}.');
                            """
                            break
                        case 'DELETE_COLLECTION':
                            jsScript = """
                            use ${params.DB_NAME};
                            db.${params.COLLECTION_NAME}.drop();
                            print('Collection ${params.COLLECTION_NAME} successfully deleted.');
                            """
                            break
                        case 'INSERT_DOCUMENT':
                            jsScript = """
                            use ${params.DB_NAME};
                            db.${params.COLLECTION_NAME}.insertOne(${params.DOC_PAYLOAD});
                            print('Document inserted into ${params.COLLECTION_NAME}.');
                            """
                            break
                        case 'UPDATE_DOCUMENT':
                            jsScript = """
                            use ${params.DB_NAME};
                            db.${params.COLLECTION_NAME}.updateMany(${params.DOC_FILTER}, ${params.DOC_PAYLOAD});
                            print('Documents updated in ${params.COLLECTION_NAME}.');
                            """
                            break
                        case 'DELETE_DOCUMENT':
                            jsScript = """
                            use ${params.DB_NAME};
                            db.${params.COLLECTION_NAME}.deleteMany(${params.DOC_FILTER});
                            print('Documents deleted from ${params.COLLECTION_NAME}.');
                            """
                            break
                    }

                    def scriptText = ""
                    if (params.MONGO_ACTION == 'CHECK_STATUS') {
                        scriptText = """#!/bin/bash
export MONGO_USER=\$(echo "${mongoUserB64}" | base64 -d 2>/dev/null || echo "${mongoUserB64}" | base64 --decode)
export MONGO_PASS=\$(echo "${mongoPassB64}" | base64 -d 2>/dev/null || echo "${mongoPassB64}" | base64 --decode)

echo "--- MongoDB Status Check ---"
if sudo systemctl is-active --quiet mongod; then
    echo "[Service] mongod is UP"
else
    echo "[Service] mongod is DOWN"
fi

if mongosh admin -u "\$MONGO_USER" -p "\$MONGO_PASS" --eval "db.adminCommand({ping: 1})" --quiet >/dev/null 2>&1; then
    echo "[Connection] MongoDB is accepting authenticated connections (UP)"
else
    echo "[Connection] MongoDB connection/authentication failed (DOWN)"
fi
"""
                    } else if (params.MONGO_ACTION == 'START_SERVER') {
                        scriptText = """#!/bin/bash
echo "Starting MongoDB server..."
sudo systemctl start mongod
if sudo systemctl is-active --quiet mongod; then
    echo "MongoDB server started successfully."
else
    echo "Failed to start MongoDB server."
    exit 1
fi
"""
                    } else if (params.MONGO_ACTION == 'STOP_SERVER') {
                        scriptText = """#!/bin/bash
echo "Stopping MongoDB server..."
sudo systemctl stop mongod
if ! sudo systemctl is-active --quiet mongod; then
    echo "MongoDB server stopped successfully."
else
    echo "Failed to stop MongoDB server."
    exit 1
fi
"""
                    } else {
                        scriptText = """#!/bin/bash
export MONGO_USER=\$(echo "${mongoUserB64}" | base64 -d 2>/dev/null || echo "${mongoUserB64}" | base64 --decode)
export MONGO_PASS=\$(echo "${mongoPassB64}" | base64 -d 2>/dev/null || echo "${mongoPassB64}" | base64 --decode)

mongosh admin -u "\$MONGO_USER" -p "\$MONGO_PASS" --quiet << 'EOF'
${jsScript}
EOF
"""
                    }

                    writeFile file: 'mongo_script.sh', text: scriptText
                }
            }
        }

        stage('Execute Operation via SSH') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'aws-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY'),
                    file(credentialsId: 'gcp-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS'),
                    usernamePassword(credentialsId: 'azure-creds', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET')
                ]) {
                    script {
                        if (params.CLOUD == 'AWS') {
                            if (isUnix()) {
                                sh """
                                export AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
                                export AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
                                echo "Retrieving SSH key from AWS Secrets Manager..."
                                rm -f private_key.pem
                                aws secretsmanager get-secret-value --secret-id ${params.SECRET_NAME} --query SecretString --output text --region ${params.AWS_REGION} > private_key.pem
                                """
                            } else {
                                bat """
                                @echo off
                                set AWS_ACCESS_KEY_ID=%AWS_ACCESS_KEY_ID%
                                set AWS_SECRET_ACCESS_KEY=%AWS_SECRET_ACCESS_KEY%
                                echo Retrieving SSH key from AWS Secrets Manager...
                                if exist private_key.pem del /F /Q private_key.pem
                                call aws secretsmanager get-secret-value --secret-id ${params.SECRET_NAME} --query SecretString --output text --region ${params.AWS_REGION} > private_key.pem
                                """
                            }
                        } else if (params.CLOUD == 'GCP') {
                            if (isUnix()) {
                                sh """
                                export GOOGLE_APPLICATION_CREDENTIALS="${GOOGLE_APPLICATION_CREDENTIALS}"
                                gcloud auth activate-service-account --key-file="\${GOOGLE_APPLICATION_CREDENTIALS}" --quiet
                                echo "Retrieving SSH key from GCP Secret Manager..."
                                rm -f private_key.pem
                                gcloud secrets versions access latest --secret="${params.SECRET_NAME}" --project="${params.GCP_PROJECT}" > private_key.pem
                                """
                            } else {
                                bat """
                                @echo off
                                set GOOGLE_APPLICATION_CREDENTIALS=%GOOGLE_APPLICATION_CREDENTIALS%
                                call gcloud auth activate-service-account --key-file="%GOOGLE_APPLICATION_CREDENTIALS%" --quiet
                                echo Retrieving SSH key from GCP Secret Manager...
                                if exist private_key.pem del /F /Q private_key.pem
                                call gcloud secrets versions access latest --secret="${params.SECRET_NAME}" --project="${params.GCP_PROJECT}" > private_key.pem
                                """
                            }
                        } else if (params.CLOUD == 'AZURE') {
                            if (isUnix()) {
                                sh """
                                export ARM_CLIENT_ID="${ARM_CLIENT_ID}"
                                export ARM_CLIENT_SECRET="${ARM_CLIENT_SECRET}"
                                az login --service-principal -u \${ARM_CLIENT_ID} -p \${ARM_CLIENT_SECRET} --tenant ${params.AZURE_TENANT_ID} >/dev/null 2>&1
                                echo "Retrieving SSH key from Azure Key Vault..."
                                rm -f private_key.pem
                                az keyvault secret show --vault-name ${params.AZURE_VAULT_NAME} --name ${params.SECRET_NAME} --query value -o tsv > private_key.pem
                                """
                            } else {
                                bat """
                                @echo off
                                set ARM_CLIENT_ID=%ARM_CLIENT_ID%
                                set ARM_CLIENT_SECRET=%ARM_CLIENT_SECRET%
                                call az login --service-principal -u %ARM_CLIENT_ID% -p %ARM_CLIENT_SECRET% --tenant ${params.AZURE_TENANT_ID} >nul 2>&1
                                echo Retrieving SSH key from Azure Key Vault...
                                if exist private_key.pem del /F /Q private_key.pem
                                call az keyvault secret show --vault-name ${params.AZURE_VAULT_NAME} --name ${params.SECRET_NAME} --query value -o tsv > private_key.pem
                                """
                            }
                        }

                        // Execute the SSH commands
                        if (isUnix()) {
                            sh """
                            chmod 400 private_key.pem
                            
                            echo "--------------------------------------------------"
                            if [ -n "${params.BASTION_IP}" ]; then
                                echo "Uploading operation script to instance via Bastion..."
                                if scp -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %h:%p ec2-user@${params.BASTION_IP}" mongo_script.sh ubuntu@${params.PRIVATE_IP}:/tmp/mongo_script.sh 2>/dev/null; then
                                    TARGET_USER="ubuntu"
                                    BASTION_USER="ec2-user"
                                elif scp -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %h:%p ec2-user@${params.BASTION_IP}" mongo_script.sh ec2-user@${params.PRIVATE_IP}:/tmp/mongo_script.sh 2>/dev/null; then
                                    TARGET_USER="ec2-user"
                                    BASTION_USER="ec2-user"
                                else
                                    echo "ERROR: Failed to connect via Bastion. Check your SSH Key or IPs."
                                    exit 1
                                fi
                                echo "Executing MongoDB operation: ${params.MONGO_ACTION} as \$TARGET_USER"
                                ssh -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %h:%p \$BASTION_USER@${params.BASTION_IP}" \$TARGET_USER@${params.PRIVATE_IP} "chmod +x /tmp/mongo_script.sh && /tmp/mongo_script.sh"
                            else
                                echo "Uploading operation script directly to Private IP..."
                                if scp -i private_key.pem -o StrictHostKeyChecking=no mongo_script.sh ubuntu@${params.PRIVATE_IP}:/tmp/mongo_script.sh 2>/dev/null; then
                                    TARGET_USER="ubuntu"
                                elif scp -i private_key.pem -o StrictHostKeyChecking=no mongo_script.sh ec2-user@${params.PRIVATE_IP}:/tmp/mongo_script.sh 2>/dev/null; then
                                    TARGET_USER="ec2-user"
                                else
                                    echo "ERROR: Failed to connect to Target. Check your SSH Key or IP."
                                    exit 1
                                fi
                                echo "Executing MongoDB operation: ${params.MONGO_ACTION} as \$TARGET_USER"
                                ssh -i private_key.pem -o StrictHostKeyChecking=no \$TARGET_USER@${params.PRIVATE_IP} "chmod +x /tmp/mongo_script.sh && /tmp/mongo_script.sh"
                            fi
                            echo "--------------------------------------------------"
                            
                            rm -f private_key.pem mongo_script.sh
                            """
                        } else {
                            bat """
                            @echo off
                            :: Fix SSH key permissions for Windows Jenkins Agent
                            icacls private_key.pem /inheritance:r /Q
                            for /f "tokens=*" %%a in ('whoami') do icacls private_key.pem /grant:r "%%a:(R)" /Q
                            
                            echo --------------------------------------------------
                            if not "${params.BASTION_IP}"=="" (
                                echo Uploading operation script to instance via Bastion...
                                scp -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %%h:%%p ec2-user@${params.BASTION_IP}" mongo_script.sh ubuntu@${params.PRIVATE_IP}:/tmp/mongo_script.sh >nul 2>&1
                                if !ERRORLEVEL! equ 0 (
                                    echo Executing MongoDB operation: ${params.MONGO_ACTION} as ubuntu
                                    ssh -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %%h:%%p ec2-user@${params.BASTION_IP}" ubuntu@${params.PRIVATE_IP} "chmod +x /tmp/mongo_script.sh && /tmp/mongo_script.sh"
                                ) else (
                                    scp -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %%h:%%p ec2-user@${params.BASTION_IP}" mongo_script.sh ec2-user@${params.PRIVATE_IP}:/tmp/mongo_script.sh >nul 2>&1
                                    if !ERRORLEVEL! equ 0 (
                                        echo Executing MongoDB operation: ${params.MONGO_ACTION} as ec2-user
                                        ssh -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %%h:%%p ec2-user@${params.BASTION_IP}" ec2-user@${params.PRIVATE_IP} "chmod +x /tmp/mongo_script.sh && /tmp/mongo_script.sh"
                                    ) else (
                                        echo ERROR: Failed to connect via Bastion.
                                        exit /b 1
                                    )
                                )
                            ) else (
                                echo Uploading operation script directly to Private IP...
                                scp -i private_key.pem -o StrictHostKeyChecking=no mongo_script.sh ubuntu@${params.PRIVATE_IP}:/tmp/mongo_script.sh >nul 2>&1
                                if !ERRORLEVEL! equ 0 (
                                    echo Executing MongoDB operation: ${params.MONGO_ACTION} as ubuntu
                                    ssh -i private_key.pem -o StrictHostKeyChecking=no ubuntu@${params.PRIVATE_IP} "chmod +x /tmp/mongo_script.sh && /tmp/mongo_script.sh"
                                ) else (
                                    scp -i private_key.pem -o StrictHostKeyChecking=no mongo_script.sh ec2-user@${params.PRIVATE_IP}:/tmp/mongo_script.sh >nul 2>&1
                                    if !ERRORLEVEL! equ 0 (
                                        echo Executing MongoDB operation: ${params.MONGO_ACTION} as ec2-user
                                        ssh -i private_key.pem -o StrictHostKeyChecking=no ec2-user@${params.PRIVATE_IP} "chmod +x /tmp/mongo_script.sh && /tmp/mongo_script.sh"
                                    ) else (
                                        echo ERROR: Failed to connect to Target.
                                        exit /b 1
                                    )
                                )
                            )
                            echo --------------------------------------------------
                            
                            :: Cleanup
                            del private_key.pem
                            del mongo_script.sh
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                if (fileExists('private_key.pem')) { isUnix() ? sh("rm -f private_key.pem") : bat("del private_key.pem") }
                if (fileExists('mongo_script.sh')) { isUnix() ? sh("rm -f mongo_script.sh") : bat("del mongo_script.sh") }
            }
        }
    }
}