pipeline {
    agent any

    parameters {
        choice(name: 'ACTION', choices: ['START', 'STOP'], description: 'Action to perform.')
        choice(name: 'CLOUD', choices: ['AWS', 'GCP', 'AZURE'], description: 'Target cloud provider.')
        string(name: 'IMAGE_ID', defaultValue: '', description: 'AMI ID, GCP Image, or Azure Image ID to launch (required for START if not using latest).')
        string(name: 'INSTANCE_ID', defaultValue: '', description: 'Instance ID to stop (required for STOP).')
        string(name: 'SECRET_NAME', defaultValue: '', description: 'Name of the secret containing the SSH key (e.g. prod-key-1-secret).')
        string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'AWS region.')
        string(name: 'GCP_PROJECT', defaultValue: 'packer-demo-456789', description: 'GCP project ID.')
        string(name: 'GCP_ZONE', defaultValue: 'us-central1-a', description: 'GCP zone.')
        string(name: 'AZURE_VAULT_NAME', defaultValue: 'packer-vault', description: 'Azure Key Vault name.')
        string(name: 'AZURE_RESOURCE_GROUP', defaultValue: 'packer-resources', description: 'Azure resource group.')
        string(name: 'AZURE_SUBSCRIPTION_ID', defaultValue: 'b943e408-73c1-4cea-b780-689120606f67', description: 'Azure subscription ID')
        string(name: 'AZURE_TENANT_ID', defaultValue: '8344e416-02b8-4b70-a912-1995cc408f19', description: 'Azure tenant ID.')
        string(name: 'EMAIL', defaultValue: 'mounika.b5693@outlook.com', description: 'Email for notification.')
    }

    stages {
        stage('Manage Instance') {
            steps {
                script {
                    withCredentials([
                        usernamePassword(credentialsId: 'aws-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY'),
                        file(credentialsId: 'gcp-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS'),
                        usernamePassword(credentialsId: 'azure-creds', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET')
                    ]) {
                        if (params.ACTION == 'START') {
                            deployInstance()
                        } else {
                            stopInstance()
                        }
                    }
                    // Cleanup temporary files
                    if (fileExists('gcloud_exe.env')) { bat "del gcloud_exe.env" }
                    if (fileExists('az_exe.env')) { bat "del az_exe.env" }
                }
            }
        }
    }

    post {
        always {
            script {
                def status = currentBuild.result ?: 'SUCCESS'
                emailext(
                    subject: "Instance ${params.ACTION} on ${params.CLOUD}: ${status}",
                    body: "Action: ${params.ACTION}\nCloud: ${params.CLOUD}\nInstance: ${env.TARGET_INSTANCE_ID ?: params.INSTANCE_ID}\nIP: ${env.PUBLIC_IP ?: 'N/A'}\n\nNote: If SSH fails, please wait 2-3 minutes for the instance to finish booting.",
                    to: "${params.EMAIL}"
                )
            }
        }
    }
}

def deployInstance() {
    switch(params.CLOUD) {
        case 'AWS':
            bat """
            @echo off
            set AWS_ACCESS_KEY_ID=%AWS_ACCESS_KEY_ID%
            set AWS_SECRET_ACCESS_KEY=%AWS_SECRET_ACCESS_KEY%
            set AWS_DEFAULT_REGION=${params.AWS_REGION}
            
            :: 1. Security Group Management
            for /f "tokens=*" %%i in ('call aws ec2 describe-security-groups --group-names production-web-sg --query "SecurityGroups[0].GroupId" --output text 2^>nul') do set SG_ID=%%i
            if "%SG_ID%"=="" (
                for /f "tokens=*" %%i in ('call aws ec2 create-security-group --group-name production-web-sg --description "Production Security Group" --query "GroupId" --output text') do set SG_ID=%%i
            )
            call aws ec2 authorize-security-group-ingress --group-id %SG_ID% --protocol tcp --port 22 --cidr 0.0.0.0/0 2>nul
            call aws ec2 authorize-security-group-ingress --group-id %SG_ID% --protocol tcp --port 80 --cidr 0.0.0.0/0 2>nul
            call aws ec2 authorize-security-group-ingress --group-id %SG_ID% --protocol icmp --port -1 --cidr 0.0.0.0/0 2>nul

            :: 2. Find Image
            set TARGET_IMAGE=${params.IMAGE_ID}
            if "%TARGET_IMAGE%"=="" (
                for /f "tokens=*" %%i in ('call aws ec2 describe-images --owners self --filters "Name=name,Values=multi-cloud-ubuntu-*" --query "sort_by(Images, &CreationDate)[-1].ImageId" --output text') do set TARGET_IMAGE=%%i
            )

            :: 3. Launch
            set KEY_NAME=${params.SECRET_NAME.replace('-secret','')}
            for /f "tokens=*" %%i in ('call aws ec2 run-instances --image-id %TARGET_IMAGE% --instance-type t2.micro --security-group-ids %SG_ID% --key-name %KEY_NAME% --associate-public-ip-address --query "Instances[0].InstanceId" --output text') do set INST_ID=%%i
            call aws ec2 wait instance-running --instance-ids %INST_ID%
            for /f "tokens=*" %%i in ('call aws ec2 describe-instances --instance-ids %INST_ID% --query "Reservations[0].Instances[0].PublicIpAddress" --output text') do set PUBLIC_IP=%%i
            
            echo TARGET_INSTANCE_ID=%INST_ID% > env.props
            echo PUBLIC_IP=%PUBLIC_IP% >> env.props
            """
            break
            
        case 'GCP':
            bat """
            @echo off
            setlocal enabledelayedexpansion
            set GCLOUD_EXE=${env.GCLOUD_EXE}
            if "!GCLOUD_EXE!"=="" ( echo ERROR: gcloud CLI not found.; exit /b 1 )

            set GOOGLE_APPLICATION_CREDENTIALS=%GOOGLE_APPLICATION_CREDENTIALS%
            
            set INSTANCE_NAME=prod-vm-%BUILD_NUMBER%
            
            :: 1. Firewall Rules
            echo Ensuring Firewall Rules...
            call "!GCLOUD_EXE!" compute firewall-rules create allow-ssh-http-icmp --allow tcp:22,tcp:80,icmp --target-tags=prod-web --project=${params.GCP_PROJECT} 2>nul
            
            :: 2. Launch
            echo Launching GCP Instance...
            call "!GCLOUD_EXE!" compute instances create %INSTANCE_NAME% ^
                --image=${params.IMAGE_ID} ^
                --project=${params.GCP_PROJECT} ^
                --zone=${params.GCP_ZONE} ^
                --machine-type=e2-micro ^
                --tags=prod-web ^
                --format="get(networkInterfaces[0].accessConfigs[0].natIP)" > nat_ip.txt
            
            if %ERRORLEVEL% neq 0 (
                echo GCP Instance launch failed.
                exit /b %ERRORLEVEL%
            )
            
            set /p PUBLIC_IP=<nat_ip.txt
            echo TARGET_INSTANCE_ID=%INSTANCE_NAME% > env.props
            echo PUBLIC_IP=%PUBLIC_IP% >> env.props
            """
            break
            
        case 'AZURE':
            bat """
            @echo off
            :: Ensure common paths are in PATH
            set "PATH=%PATH%;C:\\Program Files (x86)\\Microsoft SDKs\\Azure\\CLI2\\wbin;C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\bin"
            
            set ARM_CLIENT_ID=%ARM_CLIENT_ID%
            set ARM_CLIENT_SECRET=%ARM_CLIENT_SECRET%
            set VM_NAME=prod-vm-%BUILD_NUMBER%
            
            call az login --service-principal -u %ARM_CLIENT_ID% -p %ARM_CLIENT_SECRET% --tenant ${params.AZURE_TENANT_ID}
            call az account set --subscription ${params.AZURE_SUBSCRIPTION_ID}
            
            :: 1. Launch
            echo Launching Azure VM...
            call az vm create ^
                --resource-group ${params.AZURE_RESOURCE_GROUP} ^
                --name %VM_NAME% ^
                --image ${params.IMAGE_ID} ^
                --admin-username azureuser ^
                --public-ip-sku Standard ^
                --nsg-rule SSH ^
                --query "{ip:publicIpAddress, id:id}" --output json > vm_info.json
            
            if %ERRORLEVEL% neq 0 (
                echo Azure VM launch failed.
                exit /b %ERRORLEVEL%
            )
            
            :: 2. Open Port 80
            echo Opening Port 80...
            call "!AZ_EXE!" vm open-port --resource-group ${params.AZURE_RESOURCE_GROUP} --name %VM_NAME% --port 80
            """
            // Extract IP from JSON
            def vmInfo = readJSON file: 'vm_info.json'
            env.TARGET_INSTANCE_ID = vmInfo.id
            env.PUBLIC_IP = vmInfo.ip
            return // Skip property reading
            break
    }
    def props = readProperties file: 'env.props'
    env.TARGET_INSTANCE_ID = props['TARGET_INSTANCE_ID']
    env.PUBLIC_IP = props['PUBLIC_IP']
}

def stopInstance() {
    switch(params.CLOUD) {
        case 'AWS':
            bat "call aws ec2 stop-instances --instance-ids ${params.INSTANCE_ID} --region ${params.AWS_REGION}"
            break
        case 'GCP':
            bat """
            @echo off
            setlocal enabledelayedexpansion
            set GCLOUD_EXE=${env.GCLOUD_EXE}
            if "!GCLOUD_EXE!"=="" ( echo ERROR: gcloud CLI not found.; exit /b 1 )
            call "!GCLOUD_EXE!" compute instances stop ${params.INSTANCE_ID} --project=${params.GCP_PROJECT} --zone=${params.GCP_ZONE}
            """
            break
        case 'AZURE':
            withCredentials([usernamePassword(credentialsId: 'azure-creds', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET')]) {
                bat """
                @echo off
                setlocal enabledelayedexpansion
                set AZ_EXE=${env.AZ_EXE}
                if "!AZ_EXE!"=="" ( echo ERROR: Azure CLI not found.; exit /b 1 )
                set ARM_CLIENT_ID=%ARM_CLIENT_ID%
                set ARM_CLIENT_SECRET=%ARM_CLIENT_SECRET%
                call "!AZ_EXE!" login --service-principal -u %ARM_CLIENT_ID% -p %ARM_CLIENT_SECRET% --tenant ${params.AZURE_TENANT_ID}
                call "!AZ_EXE!" account set --subscription ${params.AZURE_SUBSCRIPTION_ID}
                call "!AZ_EXE!" vm stop --resource-group ${params.AZURE_RESOURCE_GROUP} --name ${params.INSTANCE_ID}
                """
            }
            break
    }
}
