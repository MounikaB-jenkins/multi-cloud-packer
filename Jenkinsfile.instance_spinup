pipeline {
    agent any

    parameters {
        choice(name: 'ACTION', choices: ['START', 'STOP'], description: 'Action to perform.')
        choice(name: 'CLOUD', choices: ['AWS', 'GCP', 'AZURE'], description: 'Target cloud provider.')
        string(name: 'BRANCH_NAME', defaultValue: 'develop', description: 'Git branch to checkout and run.')
        string(name: 'IMAGE_ID', defaultValue: '', description: 'AMI ID, GCP Image, or Azure Image ID to launch (required for START if not using latest).')
        string(name: 'INSTANCE_ID', defaultValue: '', description: 'Instance ID to stop (required for STOP).')
        string(name: 'BASTION_IP', defaultValue: '', description: 'Public IP of the Bastion Host. Required for SSH access to private instances.')
        string(name: 'SECRET_NAME', defaultValue: '', description: 'Name of the secret containing the SSH key (e.g. prod-key-1-secret).')
        
        string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'AWS region.')
        string(name: 'AWS_VPC_ID', defaultValue: '', description: 'AWS VPC ID. Required if your account has no default VPC.')
        string(name: 'AWS_SUBNET_ID', defaultValue: '', description: 'AWS Subnet ID. Required if your account has no default VPC.')
        string(name: 'GCP_PROJECT', defaultValue: 'packer-demo-456789', description: 'GCP project ID.')
        string(name: 'GCP_ZONE', defaultValue: 'us-central1-a', description: 'GCP zone.')
        string(name: 'AZURE_VAULT_NAME', defaultValue: 'packer-vault', description: 'Azure Key Vault name.')
        string(name: 'AZURE_RESOURCE_GROUP', defaultValue: 'packer-resources', description: 'Azure resource group.')
        string(name: 'AZURE_SUBSCRIPTION_ID', defaultValue: 'b943e408-73c1-4cea-b780-689120606f67', description: 'Azure subscription ID')
        string(name: 'AZURE_TENANT_ID', defaultValue: '8344e416-02b8-4b70-a912-1995cc408f19', description: 'Azure tenant ID.')
        string(name: 'EMAIL', defaultValue: 'mounika.b5693@outlook.com', description: 'Email for notification.')
    }

    stages {
        stage('Manage Instance') {
            steps {
                script {
                    if (isUnix()) {
                        env.GCLOUD_EXE = "gcloud"
                        env.AZ_EXE = "az"
                    } else {
                        // Find gcloud executable
                        env.GCLOUD_EXE = bat(returnStdout: true, script: """@echo off
                        setlocal enabledelayedexpansion
                        set "GCLOUD_EXE_FOUND="
                        where gcloud >nul 2>&1
                        if !ERRORLEVEL! equ 0 (
                            set "GCLOUD_EXE_FOUND=gcloud"
                        ) else (
                            for %%p in ("C:\\Users\\vresh\\AppData\\Local\\Google\\Cloud SDK\\google-cloud-sdk\\bin" "C:\\Program Files (x86)\\Google\\Cloud SDK\\google-cloud-sdk\\bin" "C:\\Program Files\\Google\\Cloud SDK\\google-cloud-sdk\\bin" "%LocalAppData%\\Google\\Cloud SDK\\google-cloud-sdk\\bin") do (
                                if exist "%%~p\\gcloud.cmd" if "!GCLOUD_EXE_FOUND!"=="" set "GCLOUD_EXE_FOUND=%%~p\\gcloud.cmd"
                            )
                        )
                        if "!GCLOUD_EXE_FOUND!" neq "" echo !GCLOUD_EXE_FOUND!
                        exit /b 0
                        """).trim()

                        // Find az executable
                        env.AZ_EXE = bat(returnStdout: true, script: """@echo off
                        setlocal enabledelayedexpansion
                        set "AZ_EXE_FOUND="
                        for %%p in ("C:\\Program Files\\Microsoft SDKs\\Azure\\CLI2\\wbin" "C:\\Program Files (x86)\\Microsoft SDKs\\Azure\\CLI2\\wbin") do (
                            if exist "%%~p\\az.cmd" if "!AZ_EXE_FOUND!"=="" set "AZ_EXE_FOUND=%%~p\\az.cmd"
                        )
                        if "!AZ_EXE_FOUND!"=="" (
                            where az >nul 2>&1
                            if !ERRORLEVEL! equ 0 set "AZ_EXE_FOUND=az"
                        )
                        if "!AZ_EXE_FOUND!" neq "" echo !AZ_EXE_FOUND!
                        exit /b 0
                        """).trim()
                    }

                    withCredentials([
                        usernamePassword(credentialsId: 'aws-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY'),
                        file(credentialsId: 'gcp-key', variable: 'GOOGLE_APPLICATION_CREDENTIALS'),
                        usernamePassword(credentialsId: 'azure-creds', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET')
                    ]) {
                        if (params.ACTION == 'START') {
                            deployInstance()
                        } else {
                            stopInstance()
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def status = currentBuild.result ?: 'SUCCESS'
                try {
                    emailext(
                        subject: "Instance ${params.ACTION} on ${params.CLOUD}: ${status}",
                        body: "Action: ${params.ACTION}\nCloud: ${params.CLOUD}\nInstance: ${env.TARGET_INSTANCE_ID ?: params.INSTANCE_ID}\nPrivate IP: ${env.PRIVATE_IP ?: 'N/A'}\nBastion IP: ${env.BASTION_IP ?: 'N/A'}\n\nNote: If SSH fails, please wait 2-3 minutes for the instance to finish booting.",
                        to: "${params.EMAIL}"
                    )
                } catch (Exception e) {
                    echo "Notice: SMTP email notification failed, but the build was successful. Error: ${e.message}"
                }
            }
        }
    }
}

def deployInstance() {
    if (params.CLOUD == 'AWS') {

        // Retrieve MongoDB Credentials from AWS Secrets Manager
        if (isUnix()) {
            sh """
            export AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
            export AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
            aws secretsmanager get-secret-value --secret-id mongodb-creds --query SecretString --output text --region ${params.AWS_REGION} > mongo_creds.json
            """
        } else {
            bat """@echo off
            set AWS_ACCESS_KEY_ID=%AWS_ACCESS_KEY_ID%
            set AWS_SECRET_ACCESS_KEY=%AWS_SECRET_ACCESS_KEY%
            aws secretsmanager get-secret-value --secret-id mongodb-creds --query SecretString --output text --region ${params.AWS_REGION} > mongo_creds.json
            """
        }
        def mongoCreds = readJSON file: 'mongo_creds.json'
        def mongoUser = mongoCreds.username
        def mongoPass = mongoCreds.password
        if (isUnix()) { sh "rm -f mongo_creds.json" } else { bat "del mongo_creds.json" }

        writeFile file: 'setup_mongo.sh', text: """#!/bin/bash
if [ -f /etc/os-release ]; then
    . /etc/os-release
    OS=\$ID
else
    OS=\$(uname -s)
fi

if [[ "\$OS" == "ubuntu"* ]] || [[ "\$OS" == "debian"* ]]; then
    sudo apt-get update
    sudo apt-get install -y gnupg curl
    curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc | sudo gpg -o /usr/share/keyrings/mongodb-server-7.0.gpg --dearmor --yes
    echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-7.0.gpg ] https://repo.mongodb.org/apt/ubuntu jammy/mongodb-org/7.0 multiverse" | sudo tee /etc/apt/sources.list.d/mongodb-org-7.0.list
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y mongodb-org
elif [[ "\$OS" == "amzn"* ]] || [[ "\$OS" == "centos"* ]] || [[ "\$OS" == "rhel"* ]]; then
    cat <<EOF | sudo tee /etc/yum.repos.d/mongodb-org-7.0.repo
[mongodb-org-7.0]
name=MongoDB Repository
baseurl=https://repo.mongodb.org/yum/amazon/2023/mongodb-org/7.0/x86_64/
gpgcheck=1
enabled=1
gpgkey=https://www.mongodb.org/static/pgp/server-7.0.asc
EOF
    sudo yum install -y mongodb-org
else
    echo "Unsupported OS: \$OS"
    exit 1
fi

echo "Configuring MongoDB to listen on all interfaces..."
sudo sed -i 's/bindIp: 127.0.0.1/bindIp: 0.0.0.0/' /etc/mongod.conf

sudo systemctl start mongod
sudo systemctl enable mongod

echo "Waiting for MongoDB to start..."
for i in {1..30}; do
    if mongosh --eval "db.adminCommand({ping: 1})" --quiet >/dev/null 2>&1; then
        break
    fi
    if [ \$i -eq 30 ]; then echo "Timeout waiting for MongoDB." && exit 1; fi
    sleep 2
done

echo "Creating admin user..."
mongosh admin --eval 'db.createUser({user: "${mongoUser}", pwd: "${mongoPass}", roles: [{role: "root", db: "admin"}]})'

echo "Enabling authentication..."
sudo sed -i 's/^#security:/security:\\n  authorization: enabled/' /etc/mongod.conf

sudo systemctl restart mongod
echo "Waiting for MongoDB to restart with auth..."
for i in {1..30}; do
    if mongosh admin -u '${mongoUser}' -p '${mongoPass}' --eval "db.adminCommand({ping: 1})" --quiet >/dev/null 2>&1; then
        break
    fi
    if [ \$i -eq 30 ]; then echo "Timeout waiting for authenticated MongoDB." && exit 1; fi
    sleep 2
done
"""

        writeFile file: 'bastion_userdata.sh', text: '''#!/bin/bash
dnf install -y iptables
sysctl -w net.ipv4.ip_forward=1
iptables -t nat -A POSTROUTING -j MASQUERADE
'''
    }
    switch(params.CLOUD) {
        case 'AWS':
            if (isUnix()) {
                sh """
                #!/bin/bash
                export AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
                export AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
                export AWS_DEFAULT_REGION=${params.AWS_REGION}
                
                # 1. Network Discovery & Setup
                if [ -n "${params.AWS_SUBNET_ID}" ]; then
                    VPC_ID=\$(aws ec2 describe-subnets --subnet-ids "${params.AWS_SUBNET_ID}" --query "Subnets[0].VpcId" --output text)
                elif [ -n "${params.AWS_VPC_ID}" ]; then
                    VPC_ID="${params.AWS_VPC_ID}"
                else
                    VPC_ID=\$(aws ec2 describe-vpcs --filters "Name=isDefault,Values=true" --query "Vpcs[0].VpcId" --output text)
                fi

                if [ -z "\$VPC_ID" ] || [ "\$VPC_ID" == "None" ]; then echo "ERROR: Could not determine VPC ID." && exit 1; fi
                echo "Operating in VPC: \$VPC_ID"

                PUBLIC_SUBNET_ID=""
                IGW_ID=\$(aws ec2 describe-internet-gateways --filters "Name=attachment.vpc-id,Values=\$VPC_ID" --query "InternetGateways[0].InternetGatewayId" --output text)
                if [ -n "\$IGW_ID" ] && [ "\$IGW_ID" != "None" ]; then
                    ROUTE_TABLES=\$(aws ec2 describe-route-tables --filters "Name=vpc-id,Values=\$VPC_ID" "Name=route.gateway-id,Values=\$IGW_ID" --query "RouteTables[*].RouteTableId" --output text)
                    for RTB in \$ROUTE_TABLES; do
                        SUBNET_ID=\$(aws ec2 describe-route-tables --route-table-ids "\$RTB" --query "RouteTables[0].Associations[*].SubnetId" --output text | tr -s '\t ' '\n' | head -n 1)
                        if [ -n "\$SUBNET_ID" ] && [ "\$SUBNET_ID" != "None" ] && [ "\$SUBNET_ID" != "null" ]; then
                            PUBLIC_SUBNET_ID="\$SUBNET_ID"
                            break
                        else
                            IS_MAIN=\$(aws ec2 describe-route-tables --route-table-ids "\$RTB" --query "RouteTables[0].Associations[*].Main" --output text | tr -s '\t ' '\n' | head -n 1)
                            if [ "\$IS_MAIN" = "True" ] || [ "\$IS_MAIN" = "true" ]; then
                                SUBNET_ID=\$(aws ec2 describe-subnets --filters "Name=vpc-id,Values=\$VPC_ID" --query "Subnets[0].SubnetId" --output text | tr -s '\t ' '\n' | head -n 1)
                                if [ -n "\$SUBNET_ID" ] && [ "\$SUBNET_ID" != "None" ]; then
                                    PUBLIC_SUBNET_ID="\$SUBNET_ID"
                                    break
                                fi
                            fi
                        fi
                    done
                fi

                if [ -z "\$PUBLIC_SUBNET_ID" ]; then echo "ERROR: Could not find a public subnet in VPC \$VPC_ID." && exit 1; fi
                echo "Found public subnet: \$PUBLIC_SUBNET_ID"

                PRIVATE_SUBNET_ID="${params.AWS_SUBNET_ID}"
                if [ -z "\$PRIVATE_SUBNET_ID" ]; then
                    ALL_SUBNETS=\$(aws ec2 describe-subnets --filters "Name=vpc-id,Values=\$VPC_ID" --query "Subnets[*].SubnetId" --output text)
                    for sub in \$ALL_SUBNETS; do
                        if [ "\$sub" != "\$PUBLIC_SUBNET_ID" ]; then
                            PRIVATE_SUBNET_ID="\$sub"
                            break
                        fi
                    done
                fi
                echo "Using private subnet: \$PRIVATE_SUBNET_ID"

                # 2. Security Group Management
                SG_ID=\$(aws ec2 describe-security-groups --filters "Name=group-name,Values=production-web-sg" "Name=vpc-id,Values=\$VPC_ID" --query "SecurityGroups[0].GroupId" --output text 2>/dev/null)
                if [ -z "\$SG_ID" ] || [ "\$SG_ID" == "None" ]; then
                    SG_ID=\$(aws ec2 create-security-group --group-name production-web-sg --description "Production Security Group" --vpc-id "\$VPC_ID" --query "GroupId" --output text)
                fi
                aws ec2 authorize-security-group-ingress --group-id "\$SG_ID" --protocol tcp --port 22 --cidr 0.0.0.0/0 2>/dev/null || true
                aws ec2 authorize-security-group-ingress --group-id "\$SG_ID" --protocol tcp --port 80 --cidr 0.0.0.0/0 2>/dev/null || true
                aws ec2 authorize-security-group-ingress --group-id "\$SG_ID" --protocol icmp --port -1 --cidr 0.0.0.0/0 2>/dev/null || true
                aws ec2 authorize-security-group-ingress --group-id "\$SG_ID" --protocol tcp --port 27017 --cidr 0.0.0.0/0 2>/dev/null || true

                VPC_CIDR=\$(aws ec2 describe-vpcs --vpc-ids "\$VPC_ID" --query "Vpcs[0].CidrBlock" --output text)
                aws ec2 authorize-security-group-ingress --group-id "\$SG_ID" --protocol all --cidr "\$VPC_CIDR" 2>/dev/null || true

                # 3. Bastion Host (NAT Configuration)
                KEY_NAME="${params.SECRET_NAME.replace('-secret','')}"
                ACTIVE_BASTION_IP="${params.BASTION_IP}"
                BASTION_ID=""

                if [ -z "\$ACTIVE_BASTION_IP" ]; then
                    BASTION_ID=\$(aws ec2 describe-instances --filters "Name=tag:Name,Values=bastion-host" "Name=instance-state-name,Values=running" "Name=vpc-id,Values=\$VPC_ID" --query "Reservations[0].Instances[0].InstanceId" --output text 2>/dev/null || echo "")
                    if [ -z "\$BASTION_ID" ] || [ "\$BASTION_ID" == "None" ]; then
                        echo "Bastion host not found. Provisioning a new Bastion Host in public subnet \$PUBLIC_SUBNET_ID as a NAT instance..."
                        AL2023_AMI=\$(aws ec2 describe-images --owners amazon --filters "Name=name,Values=al2023-ami-2023.*-x86_64" "Name=state,Values=available" --query "sort_by(Images, &CreationDate)[-1].ImageId" --output text)
                        BASTION_ID=\$(aws ec2 run-instances --image-id "\$AL2023_AMI" --instance-type t3.micro --security-group-ids "\$SG_ID" --key-name "\$KEY_NAME" --subnet-id "\$PUBLIC_SUBNET_ID" --associate-public-ip-address --user-data file://bastion_userdata.sh --tag-specifications 'ResourceType=instance,Tags=[{Key=Name,Value=bastion-host}]' --query "Instances[0].InstanceId" --output text)
                        aws ec2 wait instance-running --instance-ids "\$BASTION_ID"
                        echo "Waiting 45 seconds for bastion user-data script to complete..."
                        sleep 45
                    fi
                    ACTIVE_BASTION_IP=\$(aws ec2 describe-instances --instance-ids "\$BASTION_ID" --query "Reservations[0].Instances[0].PublicIpAddress" --output text)
                else
                    BASTION_ID=\$(aws ec2 describe-instances --filters "Name=network-interface.association.public-ip,Values=\$ACTIVE_BASTION_IP" --query "Reservations[0].Instances[0].InstanceId" --output text 2>/dev/null || echo "")
                fi

                if [ -n "\$BASTION_ID" ] && [ "\$BASTION_ID" != "None" ]; then
                    echo "Disabling Source/Dest Check on Bastion (\$BASTION_ID) to allow NAT routing..."
                    aws ec2 modify-instance-attribute --instance-id "\$BASTION_ID" --no-source-dest-check
                fi

                if [ -n "\$PRIVATE_SUBNET_ID" ] && [ -n "\$BASTION_ID" ] && [ "\$BASTION_ID" != "None" ]; then
                    echo "Configuring route table for private subnet: \$PRIVATE_SUBNET_ID to use Bastion as NAT"
                    EXPLICIT_RTB=\$(aws ec2 describe-route-tables --filters "Name=association.subnet-id,Values=\$PRIVATE_SUBNET_ID" --query "RouteTables[0].RouteTableId" --output text 2>/dev/null || echo "")
                    PUBLIC_RTB=\$(aws ec2 describe-route-tables --filters "Name=association.subnet-id,Values=\$PUBLIC_SUBNET_ID" --query "RouteTables[0].RouteTableId" --output text 2>/dev/null || echo "")
                    
                    if [ "\$EXPLICIT_RTB" == "\$PUBLIC_RTB" ] || [ -z "\$EXPLICIT_RTB" ] || [ "\$EXPLICIT_RTB" == "None" ] || [ "\$EXPLICIT_RTB" == "null" ]; then
                        echo "Creating new custom Route Table for private subnet..."
                        EXPLICIT_RTB=\$(aws ec2 create-route-table --vpc-id "\$VPC_ID" --query "RouteTable.RouteTableId" --output text)
                        
                        ASSOC_ID=\$(aws ec2 describe-route-tables --filters "Name=association.subnet-id,Values=\$PRIVATE_SUBNET_ID" --query "RouteTables[0].Associations[?SubnetId=='\$PRIVATE_SUBNET_ID'].RouteTableAssociationId" --output text 2>/dev/null)
                        if [ -n "\$ASSOC_ID" ] && [ "\$ASSOC_ID" != "None" ]; then
                            aws ec2 replace-route-table-association --association-id "\$ASSOC_ID" --route-table-id "\$EXPLICIT_RTB"
                        else
                            aws ec2 associate-route-table --subnet-id "\$PRIVATE_SUBNET_ID" --route-table-id "\$EXPLICIT_RTB"
                        fi
                    fi
                    
                    echo "Routing 0.0.0.0/0 to Bastion \$BASTION_ID in Route Table \$EXPLICIT_RTB..."
                    aws ec2 replace-route --route-table-id "\$EXPLICIT_RTB" --destination-cidr-block 0.0.0.0/0 --instance-id "\$BASTION_ID" 2>/dev/null || \
                    aws ec2 create-route --route-table-id "\$EXPLICIT_RTB" --destination-cidr-block 0.0.0.0/0 --instance-id "\$BASTION_ID" 2>/dev/null || true
                fi

                # 4. Find Image
                TARGET_IMAGE="${params.IMAGE_ID}"
                if [ -z "\$TARGET_IMAGE" ]; then
                    TARGET_IMAGE=\$(aws ec2 describe-images --owners self --filters "Name=tag:CreatedBy,Values=packer" "Name=tag:OSType,Values=Linux" --query "sort_by(Images, &CreationDate)[-1].ImageId" --output text)
                fi
                if [ -z "\$TARGET_IMAGE" ] || [ "\$TARGET_IMAGE" == "None" ]; then
                    echo "ERROR: Could not find any images. Please provide IMAGE_ID parameter."
                    exit 1
                fi

                # 5. Launch Application Instance
                APP_SUBNET_ARG=""
                if [ -n "\$PRIVATE_SUBNET_ID" ]; then APP_SUBNET_ARG="--subnet-id \$PRIVATE_SUBNET_ID"; fi
                
                INST_ID=\$(aws ec2 run-instances --image-id "\$TARGET_IMAGE" --instance-type t3.micro --security-group-ids "\$SG_ID" --key-name "\$KEY_NAME" --no-associate-public-ip-address \$APP_SUBNET_ARG --query "Instances[0].InstanceId" --output text)
                if [ -z "\$INST_ID" ]; then echo "ERROR: Failed to launch instance."; exit 1; fi
                
                aws ec2 wait instance-running --instance-ids "\$INST_ID"
                PRIVATE_IP=\$(aws ec2 describe-instances --instance-ids "\$INST_ID" --query "Reservations[0].Instances[0].PrivateIpAddress" --output text)
                if [ -z "\$PRIVATE_IP" ]; then echo "ERROR: Failed to retrieve Private IP."; exit 1; fi
                
                echo "TARGET_INSTANCE_ID=\$INST_ID" > env.props
                echo "PRIVATE_IP=\$PRIVATE_IP" >> env.props
                echo "BASTION_IP=\$ACTIVE_BASTION_IP" >> env.props
                
                echo "Retrieving SSH key from Secrets Manager..."
                rm -f private_key.pem
                aws secretsmanager get-secret-value --secret-id ${params.SECRET_NAME} --query SecretString --output text > private_key.pem
                chmod 400 private_key.pem
                
                echo "Waiting 60 seconds for SSH service to become available..."
                sleep 60
                
                if [ -n "\$ACTIVE_BASTION_IP" ]; then
                    echo "Uploading and executing MongoDB setup script via Bastion (\$ACTIVE_BASTION_IP)..."
                    scp -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %h:%p ec2-user@\$ACTIVE_BASTION_IP" setup_mongo.sh ubuntu@\$PRIVATE_IP:/tmp/setup_mongo.sh || \
                    scp -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %h:%p ec2-user@\$ACTIVE_BASTION_IP" setup_mongo.sh ec2-user@\$PRIVATE_IP:/tmp/setup_mongo.sh
                    ssh -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %h:%p ec2-user@\$ACTIVE_BASTION_IP" ubuntu@\$PRIVATE_IP "chmod +x /tmp/setup_mongo.sh && /tmp/setup_mongo.sh" || \
                    ssh -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %h:%p ec2-user@\$ACTIVE_BASTION_IP" ec2-user@\$PRIVATE_IP "chmod +x /tmp/setup_mongo.sh && /tmp/setup_mongo.sh"
                else
                    echo "Uploading and executing MongoDB setup script directly..."
                    scp -i private_key.pem -o StrictHostKeyChecking=no setup_mongo.sh ubuntu@\$PRIVATE_IP:/tmp/setup_mongo.sh || scp -i private_key.pem -o StrictHostKeyChecking=no setup_mongo.sh ec2-user@\$PRIVATE_IP:/tmp/setup_mongo.sh
                    ssh -i private_key.pem -o StrictHostKeyChecking=no ubuntu@\$PRIVATE_IP "chmod +x /tmp/setup_mongo.sh && /tmp/setup_mongo.sh" || ssh -i private_key.pem -o StrictHostKeyChecking=no ec2-user@\$PRIVATE_IP "chmod +x /tmp/setup_mongo.sh && /tmp/setup_mongo.sh"
                fi
                
                rm -f private_key.pem
                """
            } else {
            bat """
            @echo off
            setlocal enabledelayedexpansion
            set AWS_ACCESS_KEY_ID=%AWS_ACCESS_KEY_ID%
            set AWS_SECRET_ACCESS_KEY=%AWS_SECRET_ACCESS_KEY%
            set AWS_DEFAULT_REGION=${params.AWS_REGION}
            
            :: 1. Network Discovery & Setup
            set "VPC_ID="
            if not "${params.AWS_SUBNET_ID}"=="" (
                for /f "tokens=*" %%i in ('call aws ec2 describe-subnets --subnet-ids "${params.AWS_SUBNET_ID}" --query "Subnets[0].VpcId" --output text') do set "VPC_ID=%%i"
            ) else if not "${params.AWS_VPC_ID}"=="" (
                set "VPC_ID=${params.AWS_VPC_ID}"
            ) else (
                for /f "tokens=*" %%i in ('call aws ec2 describe-vpcs --filters "Name=isDefault,Values=true" --query "Vpcs[0].VpcId" --output text') do set "VPC_ID=%%i"
            )
            if "!VPC_ID!"=="" ( echo ERROR: Could not determine VPC ID. && exit /b 1 )
            if "!VPC_ID!"=="None" ( echo ERROR: Could not determine VPC ID. && exit /b 1 )
            echo Operating in VPC: !VPC_ID!

            set "PUBLIC_SUBNET_ID="
            for /f "tokens=*" %%i in ('call aws ec2 describe-internet-gateways --filters "Name=attachment.vpc-id,Values=!VPC_ID!" --query "InternetGateways[0].InternetGatewayId" --output text') do set "IGW_ID=%%i"
            if not "!IGW_ID!"=="" if not "!IGW_ID!"=="None" (
                for /f "tokens=*" %%j in ('call aws ec2 describe-route-tables --filters "Name=vpc-id,Values=!VPC_ID!" "Name=route.gateway-id,Values=!IGW_ID!" --query "RouteTables[*].RouteTableId" --output text') do (
                    set "SUBNET_ID="
                    for /f "tokens=1" %%k in ('call aws ec2 describe-route-tables --route-table-ids "%%j" --query "RouteTables[0].Associations[*].SubnetId" --output text') do (
                        if "!SUBNET_ID!"=="" set "SUBNET_ID=%%k"
                    )
                    if "!SUBNET_ID!"=="" set "SUBNET_ID=None"
                    if not "!SUBNET_ID!"=="None" if not "!SUBNET_ID!"=="null" (
                        set "PUBLIC_SUBNET_ID=!SUBNET_ID!"
                        goto found_public_subnet_bat
                    ) else (
                        set "IS_MAIN="
                        for /f "tokens=1" %%m in ('call aws ec2 describe-route-tables --route-table-ids "%%j" --query "RouteTables[0].Associations[*].Main" --output text') do (
                            if "!IS_MAIN!"=="" set "IS_MAIN=%%m"
                        )
                        if /I "!IS_MAIN!"=="true" (
                            set "SUBNET_ID="
                            for /f "tokens=1" %%n in ('call aws ec2 describe-subnets --filters "Name=vpc-id,Values=!VPC_ID!" --query "Subnets[0].SubnetId" --output text') do (
                                if "!SUBNET_ID!"=="" set "SUBNET_ID=%%n"
                            )
                            if not "!SUBNET_ID!"=="" if not "!SUBNET_ID!"=="None" (
                                set "PUBLIC_SUBNET_ID=!SUBNET_ID!"
                                goto found_public_subnet_bat
                            )
                        )
                    )
                )
            )
            :found_public_subnet_bat
            if "!PUBLIC_SUBNET_ID!"=="" ( echo ERROR: Could not find a public subnet in VPC !VPC_ID!. && exit /b 1 )
            echo Found public subnet: !PUBLIC_SUBNET_ID!

            set "PRIVATE_SUBNET_ID=${params.AWS_SUBNET_ID}"
            if "!PRIVATE_SUBNET_ID!"=="" (
                for /f "tokens=*" %%s in ('call aws ec2 describe-subnets --filters "Name=vpc-id,Values=!VPC_ID!" --query "Subnets[*].SubnetId" --output text') do (
                    for %%a in (%%s) do (
                        if "!PRIVATE_SUBNET_ID!"=="" if not "%%a"=="!PUBLIC_SUBNET_ID!" set "PRIVATE_SUBNET_ID=%%a"
                    )
                )
            )
            echo Using private subnet: !PRIVATE_SUBNET_ID!

            :: 2. Security Group Management
            for /f "tokens=*" %%i in ('call aws ec2 describe-security-groups --filters "Name=group-name,Values=production-web-sg" "Name=vpc-id,Values=!VPC_ID!" --query "SecurityGroups[0].GroupId" --output text 2^>nul') do set SG_ID=%%i
            if "!SG_ID!"=="" (
                for /f "tokens=*" %%i in ('call aws ec2 create-security-group --group-name production-web-sg --description "Production Security Group" --vpc-id !VPC_ID! --query "GroupId" --output text') do set SG_ID=%%i
            )
            call aws ec2 authorize-security-group-ingress --group-id !SG_ID! --protocol tcp --port 22 --cidr 0.0.0.0/0 2>nul
            call aws ec2 authorize-security-group-ingress --group-id !SG_ID! --protocol tcp --port 80 --cidr 0.0.0.0/0 2>nul
            call aws ec2 authorize-security-group-ingress --group-id !SG_ID! --protocol icmp --port -1 --cidr 0.0.0.0/0 2>nul
            call aws ec2 authorize-security-group-ingress --group-id !SG_ID! --protocol tcp --port 27017 --cidr 0.0.0.0/0 2>nul

            for /f "tokens=*" %%c in ('call aws ec2 describe-vpcs --vpc-ids "!VPC_ID!" --query "Vpcs[0].CidrBlock" --output text') do set "VPC_CIDR=%%c"
            call aws ec2 authorize-security-group-ingress --group-id "!SG_ID!" --protocol all --cidr "!VPC_CIDR!" 2>nul

            :: 3. Bastion Host (NAT Configuration)
            set "KEY_NAME=${params.SECRET_NAME.replace('-secret','')}"
            set "ACTIVE_BASTION_IP=${params.BASTION_IP}"
            set "BASTION_ID="

            if "!ACTIVE_BASTION_IP!"=="" (
                for /f "tokens=*" %%i in ('call aws ec2 describe-instances --filters "Name=tag:Name,Values=bastion-host" "Name=instance-state-name,Values=running" "Name=vpc-id,Values=!VPC_ID!" --query "Reservations[0].Instances[0].InstanceId" --output text 2^>nul') do set "BASTION_ID=%%i"
                if "!BASTION_ID!"=="" set "BASTION_ID=None"
                if "!BASTION_ID!"=="None" (
                    echo Bastion host not found. Provisioning a new Bastion Host in public subnet !PUBLIC_SUBNET_ID! as a NAT instance...
                    for /f "tokens=*" %%i in ('call aws ec2 describe-images --owners amazon --filters "Name=name,Values=al2023-ami-2023.*-x86_64" "Name=state,Values=available" --query "sort_by(Images, &CreationDate)[-1].ImageId" --output text') do set "AL2023_AMI=%%i"
                    for /f "tokens=*" %%i in ('call aws ec2 run-instances --image-id "!AL2023_AMI!" --instance-type t3.micro --security-group-ids "!SG_ID!" --key-name "!KEY_NAME!" --subnet-id "!PUBLIC_SUBNET_ID!" --associate-public-ip-address --user-data file://bastion_userdata.sh --tag-specifications "ResourceType=instance,Tags=[{Key=Name,Value=bastion-host}]" --query "Instances[0].InstanceId" --output text') do set "BASTION_ID=%%i"
                    call aws ec2 wait instance-running --instance-ids "!BASTION_ID!"
                    echo Waiting 45 seconds for bastion user-data script to complete...
                    ping 127.0.0.1 -n 46 > nul
                )
                for /f "tokens=*" %%i in ('call aws ec2 describe-instances --instance-ids "!BASTION_ID!" --query "Reservations[0].Instances[0].PublicIpAddress" --output text') do set "ACTIVE_BASTION_IP=%%i"
            ) else (
                for /f "tokens=*" %%i in ('call aws ec2 describe-instances --filters "Name=network-interface.association.public-ip,Values=!ACTIVE_BASTION_IP!" --query "Reservations[0].Instances[0].InstanceId" --output text 2^>nul') do set "BASTION_ID=%%i"
            )

            if not "!BASTION_ID!"=="" if not "!BASTION_ID!"=="None" (
                echo Disabling Source/Dest Check on Bastion ^(!BASTION_ID!^) to allow NAT routing...
                call aws ec2 modify-instance-attribute --instance-id "!BASTION_ID!" --no-source-dest-check
            )

            if not "!PRIVATE_SUBNET_ID!"=="" if not "!BASTION_ID!"=="" if not "!BASTION_ID!"=="None" (
                echo Configuring route table for private subnet: !PRIVATE_SUBNET_ID! to use Bastion as NAT
                set "EXPLICIT_RTB="
                for /f "tokens=*" %%r in ('call aws ec2 describe-route-tables --filters "Name=association.subnet-id,Values=!PRIVATE_SUBNET_ID!" --query "RouteTables[0].RouteTableId" --output text 2^>nul') do set "EXPLICIT_RTB=%%r"
                
                set "PUBLIC_RTB="
                for /f "tokens=*" %%r in ('call aws ec2 describe-route-tables --filters "Name=association.subnet-id,Values=!PUBLIC_SUBNET_ID!" --query "RouteTables[0].RouteTableId" --output text 2^>nul') do set "PUBLIC_RTB=%%r"
                
                set "CREATE_RTB=false"
                if "!EXPLICIT_RTB!"=="" set "CREATE_RTB=true"
                if "!EXPLICIT_RTB!"=="None" set "CREATE_RTB=true"
                if "!EXPLICIT_RTB!"=="null" set "CREATE_RTB=true"
                if "!EXPLICIT_RTB!"=="!PUBLIC_RTB!" set "CREATE_RTB=true"
                
                if "!CREATE_RTB!"=="true" (
                    echo Creating new custom Route Table for private subnet...
                    for /f "tokens=*" %%r in ('call aws ec2 create-route-table --vpc-id "!VPC_ID!" --query "RouteTable.RouteTableId" --output text') do set "EXPLICIT_RTB=%%r"
                    
                    set "ASSOC_ID="
                    for /f "tokens=*" %%a in ('call aws ec2 describe-route-tables --filters "Name=association.subnet-id,Values=!PRIVATE_SUBNET_ID!" --query "RouteTables[0].Associations[?SubnetId=='!PRIVATE_SUBNET_ID!'].RouteTableAssociationId" --output text 2^>nul') do set "ASSOC_ID=%%a"
                    
                    if not "!ASSOC_ID!"=="" if not "!ASSOC_ID!"=="None" (
                        call aws ec2 replace-route-table-association --association-id "!ASSOC_ID!" --route-table-id "!EXPLICIT_RTB!"
                    ) else (
                        call aws ec2 associate-route-table --subnet-id "!PRIVATE_SUBNET_ID!" --route-table-id "!EXPLICIT_RTB!"
                    )
                )
                
                echo Routing 0.0.0.0/0 to Bastion !BASTION_ID! in Route Table !EXPLICIT_RTB!...
                call aws ec2 replace-route --route-table-id "!EXPLICIT_RTB!" --destination-cidr-block 0.0.0.0/0 --instance-id "!BASTION_ID!" 2>nul || call aws ec2 create-route --route-table-id "!EXPLICIT_RTB!" --destination-cidr-block 0.0.0.0/0 --instance-id "!BASTION_ID!" 2>nul
            )

            :: 4. Find Image
            set TARGET_IMAGE=${params.IMAGE_ID}
            if "!TARGET_IMAGE!"=="" (
                for /f "tokens=*" %%i in ('call aws ec2 describe-images --owners self --filters "Name=tag:CreatedBy,Values=packer" "Name=tag:OSType,Values=Linux" --query "sort_by(Images, &CreationDate)[-1].ImageId" --output text') do set TARGET_IMAGE=%%i
            )
            
            if "!TARGET_IMAGE!"=="" (
                echo ERROR: Could not find any images. Please provide IMAGE_ID parameter.
                exit /b 1
            )

            :: 5. Launch Application Instance
            set "APP_SUBNET_ARG="
            if not "!PRIVATE_SUBNET_ID!"=="" set "APP_SUBNET_ARG=--subnet-id !PRIVATE_SUBNET_ID!"
            
            for /f "tokens=*" %%i in ('call aws ec2 run-instances --image-id !TARGET_IMAGE! --instance-type t3.micro --security-group-ids !SG_ID! --key-name !KEY_NAME! --no-associate-public-ip-address !APP_SUBNET_ARG! --query "Instances[0].InstanceId" --output text') do set INST_ID=%%i
            if "!INST_ID!"=="" ( echo ERROR: Failed to launch instance. && exit /b 1 )
            
            call aws ec2 wait instance-running --instance-ids !INST_ID!
            for /f "tokens=*" %%i in ('call aws ec2 describe-instances --instance-ids !INST_ID! --query "Reservations[0].Instances[0].PrivateIpAddress" --output text') do set PRIVATE_IP=%%i
            if "!PRIVATE_IP!"=="" ( echo ERROR: Failed to retrieve Private IP. && exit /b 1 )
            
            echo TARGET_INSTANCE_ID=!INST_ID! > env.props
            echo PRIVATE_IP=!PRIVATE_IP! >> env.props
            echo BASTION_IP=!ACTIVE_BASTION_IP! >> env.props
            
            :: Retrieve SSH key from AWS Secrets Manager
            echo Retrieving SSH key from Secrets Manager...
            if exist private_key.pem del /F /Q private_key.pem
            call aws secretsmanager get-secret-value --secret-id ${params.SECRET_NAME} --query SecretString --output text > private_key.pem
            
            :: Fix SSH key permissions for Windows
            icacls private_key.pem /inheritance:r /Q
            for /f "tokens=*" %%a in ('whoami') do icacls private_key.pem /grant:r "%%a:(R)" /Q
            
            echo Waiting 60 seconds for SSH service to become available...
            ping 127.0.0.1 -n 61 > nul
            
            if not "!ACTIVE_BASTION_IP!"=="" (
                echo Uploading and executing MongoDB setup script via Bastion (!ACTIVE_BASTION_IP!)...
                scp -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %%h:%%p ec2-user@!ACTIVE_BASTION_IP!" setup_mongo.sh ubuntu@!PRIVATE_IP!:/tmp/setup_mongo.sh || scp -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %%h:%%p ec2-user@!ACTIVE_BASTION_IP!" setup_mongo.sh ec2-user@!PRIVATE_IP!:/tmp/setup_mongo.sh
                ssh -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %%h:%%p ec2-user@!ACTIVE_BASTION_IP!" ubuntu@!PRIVATE_IP! "chmod +x /tmp/setup_mongo.sh && /tmp/setup_mongo.sh" || ssh -i private_key.pem -o StrictHostKeyChecking=no -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %%h:%%p ec2-user@!ACTIVE_BASTION_IP!" ec2-user@!PRIVATE_IP! "chmod +x /tmp/setup_mongo.sh && /tmp/setup_mongo.sh"
            ) else (
                echo Uploading and executing MongoDB setup script directly...
                scp -i private_key.pem -o StrictHostKeyChecking=no setup_mongo.sh ubuntu@!PRIVATE_IP!:/tmp/setup_mongo.sh || scp -i private_key.pem -o StrictHostKeyChecking=no setup_mongo.sh ec2-user@!PRIVATE_IP!:/tmp/setup_mongo.sh
                ssh -i private_key.pem -o StrictHostKeyChecking=no ubuntu@!PRIVATE_IP! "chmod +x /tmp/setup_mongo.sh && /tmp/setup_mongo.sh" || ssh -i private_key.pem -o StrictHostKeyChecking=no ec2-user@!PRIVATE_IP! "chmod +x /tmp/setup_mongo.sh && /tmp/setup_mongo.sh"
            )

            :: Cleanup local key
            if exist private_key.pem del private_key.pem
            """
            }
            break
            
        case 'GCP':
            if (isUnix()) {
                sh """
                #!/bin/bash
                INSTANCE_NAME="prod-vm-${BUILD_NUMBER}"
                ${env.GCLOUD_EXE} compute firewall-rules create allow-ssh-http-icmp-mongo --allow tcp:22,tcp:80,tcp:27017,icmp --target-tags=prod-web --project=${params.GCP_PROJECT} 2>/dev/null || true
                
                ${env.GCLOUD_EXE} compute instances create \${INSTANCE_NAME} \\
                    --image=${params.IMAGE_ID} \\
                    --project=${params.GCP_PROJECT} \\
                    --zone=${params.GCP_ZONE} \\
                    --machine-type=e2-micro \\
                    --tags=prod-web \\
                    --no-address \\
                    --format="get(networkInterfaces[0].networkIP)" > private_ip.txt || { echo "GCP Instance launch failed."; exit 1; }
                
                PRIVATE_IP=\$(cat private_ip.txt)
                if [ -z "\$PRIVATE_IP" ]; then echo "GCP Instance launch failed."; exit 1; fi
                
                ACTIVE_BASTION_IP="${params.BASTION_IP}"
                if [ -z "\$ACTIVE_BASTION_IP" ]; then
                    BASTION_NAME="bastion-host"
                    BASTION_EXISTS=\$( ${env.GCLOUD_EXE} compute instances describe \$BASTION_NAME --project=${params.GCP_PROJECT} --zone=${params.GCP_ZONE} --format="value(name)" 2>/dev/null || echo "" )
                    if [ -z "\$BASTION_EXISTS" ]; then
                        echo "Provisioning GCP Bastion Host..."
                        ${env.GCLOUD_EXE} compute instances create \$BASTION_NAME \\
                            --image-family=debian-11 \\
                            --image-project=debian-cloud \\
                            --project=${params.GCP_PROJECT} \\
                            --zone=${params.GCP_ZONE} \\
                            --machine-type=e2-micro \\
                            --tags=prod-web
                    fi
                    ACTIVE_BASTION_IP=\$( ${env.GCLOUD_EXE} compute instances describe \$BASTION_NAME --project=${params.GCP_PROJECT} --zone=${params.GCP_ZONE} --format="get(networkInterfaces[0].accessConfigs[0].natIP)" )
                fi
                
                echo "TARGET_INSTANCE_ID=\${INSTANCE_NAME}" > env.props
                echo "PRIVATE_IP=\${PRIVATE_IP}" >> env.props
                echo "BASTION_IP=\${ACTIVE_BASTION_IP}" >> env.props
                """
            } else {
            bat """
            @echo off
            setlocal enabledelayedexpansion
            set GCLOUD_EXE=${env.GCLOUD_EXE}
            if "!GCLOUD_EXE!"=="" ( echo ERROR: gcloud CLI not found.; exit /b 1 )

            set GOOGLE_APPLICATION_CREDENTIALS=%GOOGLE_APPLICATION_CREDENTIALS%
            
            set INSTANCE_NAME=prod-vm-%BUILD_NUMBER%
            
            :: 1. Firewall Rules
            echo Ensuring Firewall Rules...
            call "!GCLOUD_EXE!" compute firewall-rules create allow-ssh-http-icmp-mongo --allow tcp:22,tcp:80,tcp:27017,icmp --target-tags=prod-web --project=${params.GCP_PROJECT} 2>nul
            
            :: 2. Launch
            echo Launching GCP Instance...
            call "!GCLOUD_EXE!" compute instances create %INSTANCE_NAME% ^
                --image=${params.IMAGE_ID} ^
                --project=${params.GCP_PROJECT} ^
                --zone=${params.GCP_ZONE} ^
                --machine-type=e2-micro ^
                --tags=prod-web ^
                --no-address ^
                --format="get(networkInterfaces[0].networkIP)" > private_ip.txt
            
            if %ERRORLEVEL% neq 0 (
                echo GCP Instance launch failed.
                exit /b %ERRORLEVEL%
            )
            
            set /p PRIVATE_IP=<private_ip.txt
            
            set "ACTIVE_BASTION_IP=${params.BASTION_IP}"
            if "!ACTIVE_BASTION_IP!"=="" (
                set BASTION_NAME=bastion-host
                for /f "tokens=*" %%i in ('call "!GCLOUD_EXE!" compute instances describe !BASTION_NAME! --project=${params.GCP_PROJECT} --zone=${params.GCP_ZONE} --format="value(name)" 2^>nul') do set BASTION_EXISTS=%%i
                if "!BASTION_EXISTS!"=="" (
                    echo Provisioning GCP Bastion Host...
                    call "!GCLOUD_EXE!" compute instances create !BASTION_NAME! ^
                        --image-family=debian-11 ^
                        --image-project=debian-cloud ^
                        --project=${params.GCP_PROJECT} ^
                        --zone=${params.GCP_ZONE} ^
                        --machine-type=e2-micro ^
                        --tags=prod-web
                )
                for /f "tokens=*" %%i in ('call "!GCLOUD_EXE!" compute instances describe !BASTION_NAME! --project=${params.GCP_PROJECT} --zone=${params.GCP_ZONE} --format="get(networkInterfaces[0].accessConfigs[0].natIP)"') do set ACTIVE_BASTION_IP=%%i
            )
            
            echo TARGET_INSTANCE_ID=%INSTANCE_NAME% > env.props
            echo PRIVATE_IP=!PRIVATE_IP! >> env.props
            echo BASTION_IP=!ACTIVE_BASTION_IP! >> env.props
            """
            }
            break
            
        case 'AZURE':
            if (isUnix()) {
                sh """
                #!/bin/bash
                VM_NAME="prod-vm-${BUILD_NUMBER}"
                
                ${env.AZ_EXE} login --service-principal -u \${ARM_CLIENT_ID} -p \${ARM_CLIENT_SECRET} --tenant ${params.AZURE_TENANT_ID} >/dev/null 2>&1
                ${env.AZ_EXE} account set --subscription ${params.AZURE_SUBSCRIPTION_ID}
                
                echo "Retrieving SSH key from Key Vault..."
                rm -f private_key.pem
                ${env.AZ_EXE} keyvault secret show --vault-name ${params.AZURE_VAULT_NAME} --name ${params.SECRET_NAME} --query value -o tsv > private_key.pem || { echo "ERROR: Failed to retrieve secret."; exit 1; }
                
                chmod 400 private_key.pem
                ssh-keygen -y -f private_key.pem > public_key.pub
                
                echo "Launching Azure VM..."
                ${env.AZ_EXE} vm create \\
                    --resource-group ${params.AZURE_RESOURCE_GROUP} \\
                    --name \${VM_NAME} \\
                    --size Standard_B2ats_v2 \\
                    --image "${params.IMAGE_ID}" \\
                    --admin-username azureuser \\
                    --public-ip-address "" \\
                    --nsg-rule SSH \\
                    --ssh-key-values public_key.pub \\
                    --query "{ip:privateIps, id:id}" --output json > vm_info.json || { echo "Azure VM launch failed."; exit 1; }
                
                rm -f private_key.pem public_key.pub
                
                ACTIVE_BASTION_IP="${params.BASTION_IP}"
                if [ -z "\$ACTIVE_BASTION_IP" ]; then
                    BASTION_NAME="bastion-host"
                    BASTION_EXISTS=\$( ${env.AZ_EXE} vm show --resource-group ${params.AZURE_RESOURCE_GROUP} --name \$BASTION_NAME --query "name" -o tsv 2>/dev/null || echo "" )
                    if [ -z "\$BASTION_EXISTS" ]; then
                        echo "Provisioning Azure Bastion Host..."
                        ${env.AZ_EXE} vm create \\
                            --resource-group ${params.AZURE_RESOURCE_GROUP} \\
                            --name \$BASTION_NAME \\
                            --size Standard_B1s \\
                            --image Ubuntu2204 \\
                            --admin-username azureuser \\
                            --generate-ssh-keys \\
                            --public-ip-sku Standard > /dev/null
                    fi
                    ${env.AZ_EXE} vm show -d -g ${params.AZURE_RESOURCE_GROUP} -n \$BASTION_NAME --query publicIps -o tsv > bastion_ip.txt
                else
                    echo "\$ACTIVE_BASTION_IP" > bastion_ip.txt
                fi
                
                ${env.AZ_EXE} vm open-port --resource-group ${params.AZURE_RESOURCE_GROUP} --name \${VM_NAME} --port 80
                ${env.AZ_EXE} vm open-port --resource-group ${params.AZURE_RESOURCE_GROUP} --name \${VM_NAME} --port 27017
                """
            } else {
            bat """
            @echo off
            setlocal enabledelayedexpansion
            
            :: Prevent Python environment conflicts for Azure CLI
            set "PYTHONHOME="
            set "PYTHONPATH="
            set "PYTHONEXECUTABLE="
            
            set AZ_EXE=${env.AZ_EXE}
            if "!AZ_EXE!"=="" ( echo ERROR: Azure CLI not found.; exit /b 1 )
            
            set ARM_CLIENT_ID=%ARM_CLIENT_ID%
            set ARM_CLIENT_SECRET=%ARM_CLIENT_SECRET%
            set VM_NAME=prod-vm-%BUILD_NUMBER%
            
            call "!AZ_EXE!" login --service-principal -u %ARM_CLIENT_ID% -p %ARM_CLIENT_SECRET% --tenant ${params.AZURE_TENANT_ID}
            call "!AZ_EXE!" account set --subscription ${params.AZURE_SUBSCRIPTION_ID}
            
            :: Retrieve SSH key from Key Vault
            echo Retrieving SSH key from Key Vault...
            if exist private_key.pem del /F /Q private_key.pem
            call "!AZ_EXE!" keyvault secret show --vault-name ${params.AZURE_VAULT_NAME} --name ${params.SECRET_NAME} --query value -o tsv > private_key.pem
            
            if !ERRORLEVEL! neq 0 (
                echo ERROR: Failed to retrieve secret. Verify AZURE_VAULT_NAME and SECRET_NAME.
                exit /b 1
            )
            
            :: Fix SSH key permissions on Windows
            icacls private_key.pem /inheritance:r /Q
            for /f "tokens=*" %%a in ('whoami') do icacls private_key.pem /grant:r "%%a:(R)" /Q
            
            :: Generate public key from private key
            ssh-keygen -y -f private_key.pem > public_key.pub
            
            :: 1. Launch
            echo Launching Azure VM...
            call "!AZ_EXE!" vm create ^
                --resource-group ${params.AZURE_RESOURCE_GROUP} ^
                --name %VM_NAME% ^
                --size Standard_B2ats_v2 ^
                --image ${params.IMAGE_ID} ^
                --admin-username azureuser ^
                --public-ip-address "" ^
                --nsg-rule SSH ^
                --ssh-key-values public_key.pub ^
                --query "{ip:privateIps, id:id}" --output json > vm_info.json
            
            set VM_EXIT_CODE=!ERRORLEVEL!
            
            :: Cleanup local keys
            if exist private_key.pem del private_key.pem
            if exist public_key.pub del public_key.pub
            
            if !VM_EXIT_CODE! neq 0 (
                echo Azure VM launch failed.
                exit /b !VM_EXIT_CODE!
            )
            
            set "ACTIVE_BASTION_IP=${params.BASTION_IP}"
            if "!ACTIVE_BASTION_IP!"=="" (
                set BASTION_NAME=bastion-host
                for /f "tokens=*" %%i in ('call "!AZ_EXE!" vm show --resource-group ${params.AZURE_RESOURCE_GROUP} --name !BASTION_NAME! --query "name" -o tsv 2^>nul') do set BASTION_EXISTS=%%i
                if "!BASTION_EXISTS!"=="" (
                    echo Provisioning Azure Bastion Host...
                    call "!AZ_EXE!" vm create ^
                        --resource-group ${params.AZURE_RESOURCE_GROUP} ^
                        --name !BASTION_NAME! ^
                        --size Standard_B1s ^
                        --image Ubuntu2204 ^
                        --admin-username azureuser ^
                        --generate-ssh-keys ^
                        --public-ip-sku Standard > nul
                )
                call "!AZ_EXE!" vm show -d -g ${params.AZURE_RESOURCE_GROUP} -n !BASTION_NAME! --query publicIps -o tsv > bastion_ip.txt
            ) else (
                echo !ACTIVE_BASTION_IP!> bastion_ip.txt
            )
            
            :: 2. Open Port 80
            echo Opening Port 80...
            call "!AZ_EXE!" vm open-port --resource-group ${params.AZURE_RESOURCE_GROUP} --name %VM_NAME% --port 80
            call "!AZ_EXE!" vm open-port --resource-group ${params.AZURE_RESOURCE_GROUP} --name %VM_NAME% --port 27017
            """
            }
            // Extract IP from JSON
            def vmInfo = readJSON file: 'vm_info.json'
            env.TARGET_INSTANCE_ID = vmInfo.id
            env.PRIVATE_IP = vmInfo.ip
            if (fileExists('bastion_ip.txt')) {
                env.BASTION_IP = readFile('bastion_ip.txt').trim()
            }
            return // Skip property reading
            break
    }
    def props = readProperties file: 'env.props'
    env.TARGET_INSTANCE_ID = props['TARGET_INSTANCE_ID']
    env.PRIVATE_IP = props['PRIVATE_IP']
    if (props['BASTION_IP']) {
        env.BASTION_IP = props['BASTION_IP']
    }
}

def stopInstance() {
    switch(params.CLOUD) {
        case 'AWS':
            if (isUnix()) {
                sh "aws ec2 stop-instances --instance-ids ${params.INSTANCE_ID} --region ${params.AWS_REGION}"
            } else {
                bat "call aws ec2 stop-instances --instance-ids ${params.INSTANCE_ID} --region ${params.AWS_REGION}"
            }
            break
        case 'GCP':
            if (isUnix()) {
                sh "${env.GCLOUD_EXE} compute instances stop ${params.INSTANCE_ID} --project=${params.GCP_PROJECT} --zone=${params.GCP_ZONE} --quiet"
            } else {
                bat """
                @echo off
                setlocal enabledelayedexpansion
                set GCLOUD_EXE=${env.GCLOUD_EXE}
                if "!GCLOUD_EXE!"=="" ( echo ERROR: gcloud CLI not found.; exit /b 1 )
                call "!GCLOUD_EXE!" compute instances stop ${params.INSTANCE_ID} --project=${params.GCP_PROJECT} --zone=${params.GCP_ZONE} --quiet
                """
            }
            break
        case 'AZURE':
            withCredentials([usernamePassword(credentialsId: 'azure-creds', usernameVariable: 'ARM_CLIENT_ID', passwordVariable: 'ARM_CLIENT_SECRET')]) {
                if (isUnix()) {
                    sh """
                    #!/bin/bash
                    ${env.AZ_EXE} login --service-principal -u \$ARM_CLIENT_ID -p \$ARM_CLIENT_SECRET --tenant ${params.AZURE_TENANT_ID} >/dev/null 2>&1
                    ${env.AZ_EXE} account set --subscription ${params.AZURE_SUBSCRIPTION_ID}
                    ${env.AZ_EXE} vm deallocate --resource-group ${params.AZURE_RESOURCE_GROUP} --name ${params.INSTANCE_ID}
                    """
                } else {
                    bat """
                    @echo off
                    setlocal enabledelayedexpansion
                    
                    :: Prevent Python environment conflicts for Azure CLI
                    set "PYTHONHOME="
                    set "PYTHONPATH="
                    set "PYTHONEXECUTABLE="
                    
                    set AZ_EXE=${env.AZ_EXE}
                    if "!AZ_EXE!"=="" ( echo ERROR: Azure CLI not found.; exit /b 1 )
                    
                    set ARM_CLIENT_ID=%ARM_CLIENT_ID%
                    set ARM_CLIENT_SECRET=%ARM_CLIENT_SECRET%
                    call "!AZ_EXE!" login --service-principal -u %ARM_CLIENT_ID% -p %ARM_CLIENT_SECRET% --tenant ${params.AZURE_TENANT_ID}
                    call "!AZ_EXE!" account set --subscription ${params.AZURE_SUBSCRIPTION_ID}
                    call "!AZ_EXE!" vm stop --resource-group ${params.AZURE_RESOURCE_GROUP} --name ${params.INSTANCE_ID}
                    """
                }
            }
            break
    }
}
