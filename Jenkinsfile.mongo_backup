pipeline {
    agent any

    parameters {
        choice(name: 'ACTION', choices: ['BACKUP', 'RESTORE'], description: 'Action to perform: Backup the database or Restore from an existing backup.')
        string(name: 'TARGET_PRIVATE_IP', defaultValue: '', description: 'Private IP of the MongoDB instance.')
        string(name: 'BASTION_IP', defaultValue: '', description: 'Public IP of the Bastion Host (Leave empty if Jenkins can reach the Private IP directly).')
        string(name: 'SSH_USER', defaultValue: 'ec2-user', description: 'SSH username for the instances (e.g., ec2-user or ubuntu).')
        string(name: 'SECRET_NAME', defaultValue: '', description: 'Name of the AWS secret containing the SSH key.')
        string(name: 'MONGO_CREDENTIALS_SECRET', defaultValue: 'mongodb-creds', description: 'AWS Secret name containing MongoDB credentials.')
        string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'AWS region for the secrets.')
        string(name: 'BACKUP_DIR', defaultValue: 'mongo_backups', description: 'Local path on the Jenkins instance to store and retrieve the backups (defaults to workspace).')
        string(name: 'RESTORE_TIMESTAMP', defaultValue: 'latest', description: 'For RESTORE only: The specific timestamp folder to restore (or "latest").')
        booleanParam(name: 'DROP_BEFORE_RESTORE', defaultValue: false, description: 'For RESTORE only: Drop collections from the database before restoring.')
    }

    stages {
        stage('Setup SSH Tunnel') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'aws-creds', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
                    script {
                        echo "Retrieving SSH key and MongoDB credentials from Secrets Manager..."
                        sh """
                        export AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID}
                        export AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY}
                        export AWS_DEFAULT_REGION=${params.AWS_REGION}
                        
                        rm -f private_key.pem mongo_creds.json
                        aws secretsmanager get-secret-value --secret-id ${params.SECRET_NAME} --query SecretString --output text > private_key.pem
                        chmod 400 private_key.pem
                        
                        aws secretsmanager get-secret-value --secret-id ${params.MONGO_CREDENTIALS_SECRET} --query SecretString --output text > mongo_creds.json
                        """
                        
                        def mongoCreds = readJSON file: 'mongo_creds.json'
                        env.MONGO_USER = mongoCreds.username
                        env.MONGO_PASS = mongoCreds.password
                        sh "rm -f mongo_creds.json"
                        
                        // Map the remote MongoDB port to a local Jenkins port (27018)
                        env.LOCAL_MONGO_URI = "mongodb://${env.MONGO_USER}:${env.MONGO_PASS}@127.0.0.1:27018/?authSource=admin"
                        
                        echo "Setting up SSH Tunnel to ${params.TARGET_PRIVATE_IP}..."
                        sh """
                        # Kill any existing stray SSH tunnel on port 27018
                        pkill -f "27018:127.0.0.1:27017" || true
                        
                        if [ -n "${params.BASTION_IP}" ]; then
                            echo "Determining SSH user for Bastion (${params.BASTION_IP}) and Target (${params.TARGET_PRIVATE_IP})..."
                            if ssh -i private_key.pem -o StrictHostKeyChecking=no -o BatchMode=yes -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %h:%p ec2-user@${params.BASTION_IP}" ubuntu@${params.TARGET_PRIVATE_IP} "echo OK" >/dev/null 2>&1; then
                                TARGET_USER="ubuntu"
                                BASTION_USER="ec2-user"
                            elif ssh -i private_key.pem -o StrictHostKeyChecking=no -o BatchMode=yes -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %h:%p ec2-user@${params.BASTION_IP}" ec2-user@${params.TARGET_PRIVATE_IP} "echo OK" >/dev/null 2>&1; then
                                TARGET_USER="ec2-user"
                                BASTION_USER="ec2-user"
                            else
                                echo "ERROR: Failed to connect via Bastion. Check your SSH Key or IPs."
                                exit 1
                            fi
                            echo "Tunneling via Bastion as \$BASTION_USER to target as \$TARGET_USER..."
                            ssh -i private_key.pem -o StrictHostKeyChecking=no -f -N -L 27018:127.0.0.1:27017 -o "ProxyCommand=ssh -i private_key.pem -o StrictHostKeyChecking=no -W %h:%p \$BASTION_USER@${params.BASTION_IP}" \$TARGET_USER@${params.TARGET_PRIVATE_IP}
                        else
                            echo "Determining SSH user for Target (${params.TARGET_PRIVATE_IP})..."
                            if ssh -i private_key.pem -o StrictHostKeyChecking=no -o BatchMode=yes ubuntu@${params.TARGET_PRIVATE_IP} "echo OK" >/dev/null 2>&1; then
                                TARGET_USER="ubuntu"
                            elif ssh -i private_key.pem -o StrictHostKeyChecking=no -o BatchMode=yes ec2-user@${params.TARGET_PRIVATE_IP} "echo OK" >/dev/null 2>&1; then
                                TARGET_USER="ec2-user"
                            else
                                echo "ERROR: Failed to connect to Target. Check your SSH Key or IP."
                                exit 1
                            fi
                            echo "Tunneling directly to Private IP as \$TARGET_USER..."
                            ssh -i private_key.pem -o StrictHostKeyChecking=no -f -N -L 27018:127.0.0.1:27017 \$TARGET_USER@${params.TARGET_PRIVATE_IP}
                        fi
                        
                        echo "Waiting 5 seconds for tunnel to establish..."
                        sleep 5
                        """
                    }
                }
            }
        }

        stage('MongoDB Backup') {
            when { expression { params.ACTION == 'BACKUP' } }
            steps {
                script {
                    // Generate a timestamp for the backup directory
                    def timestamp = sh(script: "date +'%Y-%m-%d_%H-%M-%S'", returnStdout: true).trim()
                    def safeBackupDir = params.BACKUP_DIR.startsWith("/") ? "mongo_backups" : params.BACKUP_DIR
                    def currentBackupPath = "${env.WORKSPACE}/${safeBackupDir}/${timestamp}"
                    
                    echo "Taking full MongoDB backup with oplog to ${currentBackupPath}..."
                    sh """
                    mkdir -p "${currentBackupPath}"
                    
                    # Execute mongodump locally routing through the SSH tunnel
                    mongodump --uri="${env.LOCAL_MONGO_URI}" --oplog --out="${currentBackupPath}"
                    
                    # Update the 'latest' symlink for easy future restores
                    ln -sfn "${currentBackupPath}" "${env.WORKSPACE}/${safeBackupDir}/latest"
                    
                    # Create an archive to store as a Jenkins Artifact
                    tar -czf "mongo_backup_${timestamp}.tar.gz" -C "${env.WORKSPACE}/${safeBackupDir}" "${timestamp}"
                    """
                    
                    archiveArtifacts artifacts: "mongo_backup_${timestamp}.tar.gz", allowEmptyArchive: false
                    echo "Backup successful! Archived as mongo_backup_${timestamp}.tar.gz"
                }
            }
        }

        stage('MongoDB Restore') {
            when { expression { params.ACTION == 'RESTORE' } }
            steps {
                script {
                    def safeBackupDir = params.BACKUP_DIR.startsWith("/") ? "mongo_backups" : params.BACKUP_DIR
                    def targetBackupPath = "${env.WORKSPACE}/${safeBackupDir}/${params.RESTORE_TIMESTAMP}"
                    def dropFlag = params.DROP_BEFORE_RESTORE ? "--drop" : ""
                    
                    echo "Restoring MongoDB from ${targetBackupPath} with oplogReplay..."
                    sh """
                    if [ ! -d "${targetBackupPath}" ]; then
                        echo "ERROR: Backup directory ${targetBackupPath} not found!"
                        exit 1
                    fi
                    
                    # Execute mongorestore locally routing through the SSH tunnel
                    mongorestore --uri="${env.LOCAL_MONGO_URI}" --oplogReplay ${dropFlag} "${targetBackupPath}"
                    """
                    echo "Restore successful!"
                }
            }
        }
    }
    
    post {
        always {
            sh """
            pkill -f "27018:127.0.0.1:27017" || true
            rm -f private_key.pem mongo_creds.json
            rm -f mongo_backup_*.tar.gz
            """
        }
    }
}